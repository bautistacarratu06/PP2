<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="UI.Controls.SectionPicker"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:UI.Controls"
    xmlns:models="clr-namespace:GestionEscolar.Core.Models;assembly=GestionEscolar.Core">
    <Border
        BackgroundColor="{StaticResource Raised}"
        Padding="14,9"
        Stroke="{StaticResource LineStrong}"
        StrokeShape="RoundRectangle 10"
        StrokeThickness="1">
        <Grid>
            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                <Ellipse
                    Fill="{StaticResource Accent}"
                    HeightRequest="8"
                    WidthRequest="8"
                    VerticalOptions="Center" />
                <Label
                    FontFamily="InterMedium"
                    Text="Comisión"
                    TextColor="{StaticResource TextSecondary}"
                    VerticalOptions="Center" />
                <Label
                    x:Name="ValueLabel"
                    FontFamily="InterMedium"
                    TextColor="{StaticResource TextPrimary}"
                    VerticalOptions="Center" />
                <controls:Icon
                    GlyphColor="{StaticResource TextSecondary}"
                    Name="chevron-down"
                    Size="14"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Picker
                x:Name="Picker"
                BackgroundColor="Transparent"
                TextColor="Transparent"
                TitleColor="Transparent"
                SelectedIndexChanged="OnSelected"
                ItemDisplayBinding="{Binding Name, x:DataType=models:Section}" />
        </Grid>
    </Border>
</ContentView>
