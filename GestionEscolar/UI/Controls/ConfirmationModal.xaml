<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="UI.Controls.ConfirmationModal"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root"
    InputTransparent="False"
    IsVisible="{Binding IsOpen, Source={x:Reference Root}}">

    <Grid BackgroundColor="#B30B0D13" InputTransparent="False">
        <Border
            BackgroundColor="{StaticResource Surface}"
            HorizontalOptions="Center"
            MaximumWidthRequest="440"
            Padding="24"
            Stroke="{StaticResource Line}"
            StrokeShape="RoundRectangle 14"
            StrokeThickness="1"
            VerticalOptions="Center"
            WidthRequest="420">
            <VerticalStackLayout Spacing="16">
                <!-- Title -->
                <Label
                    FontFamily="InterSemibold"
                    FontSize="18"
                    Text="{Binding Title, Source={x:Reference Root}}"
                    TextColor="{StaticResource TextPrimary}" />

                <!-- Message / Counter description -->
                <Label
                    FontFamily="Inter"
                    FontSize="14"
                    LineHeight="1.3"
                    Text="{Binding Message, Source={x:Reference Root}}"
                    TextColor="{StaticResource TextSecondary}" />

                <BoxView
                    Color="{StaticResource Line}"
                    HeightRequest="1"
                    Margin="0,4" />

                <!-- Action buttons -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button
                        Command="{Binding CancelCommand, Source={x:Reference Root}}"
                        FontFamily="InterMedium"
                        HeightRequest="42"
                        Style="{StaticResource GhostButton}"
                        Text="{Binding CancelText, Source={x:Reference Root}}" />
                    <Button
                        Grid.Column="1"
                        Command="{Binding ConfirmCommand, Source={x:Reference Root}}"
                        FontFamily="InterSemibold"
                        HeightRequest="42"
                        Style="{StaticResource PrimaryButton}"
                        Text="{Binding ConfirmText, Source={x:Reference Root}}" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>

