<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="UI.Views.SubmissionsPage"
    x:DataType="vm:SubmissionsViewModel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:UI.Controls"
    xmlns:vm="clr-namespace:UI.ViewModels"
    Shell.NavBarIsVisible="False">

    <controls:PageShell Title="Registrar entregas" Subtitle="Registrá el estado de entrega de cada estudiante.">
        <Border Style="{StaticResource Card}">
            <VerticalStackLayout>
                <Grid Padding="16,14" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="12">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Style="{StaticResource FieldLabel}" Text="Trabajo" VerticalOptions="Center" />
                        <Border Style="{StaticResource FieldBorder}" Padding="8,4">
                            <Picker
                                ItemsSource="{Binding Assignments}"
                                SelectedItem="{Binding SelectedAssignment}"
                                WidthRequest="240" />
                        </Border>
                    </HorizontalStackLayout>
                    <controls:Meter
                        Grid.Column="1"
                        BarWidth="140"
                        Fill="{StaticResource Accent}"
                        ShowLabel="False"
                        Value="{Binding RegisteredProgress}"
                        VerticalOptions="Center" />
                    <Label
                        Grid.Column="2"
                        Style="{StaticResource CountLabel}"
                        Text="{Binding RegisteredText}"
                        VerticalOptions="Center" />
                </Grid>
                <BoxView HeightRequest="1" Color="{StaticResource Line}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:StatusRow">
                            <VerticalStackLayout>
                                <controls:HoverRow Padding="20,0" ColumnDefinitions="*,Auto" HeightRequest="60">
                                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                                        <controls:Avatar FullName="{Binding DisplayName}" />
                                        <Label
                                            FontFamily="InterSemibold"
                                            FontSize="14"
                                            Text="{Binding DisplayName}"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <controls:SegmentedControl
                                        Grid.Column="1"
                                        Mode="submission"
                                        SelectedKey="{Binding SelectedStatus}"
                                        VerticalOptions="Center" />
                                </controls:HoverRow>
                                <BoxView HeightRequest="1" Color="{StaticResource Line}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Label
                    IsVisible="{Binding HasNoAssignments}"
                    Style="{StaticResource EmptyLabel}"
                    Text="No hay trabajos para esta comisión. Agregalos en Calendario." />
                <Label
                    IsVisible="{Binding HasError}"
                    Padding="20,12"
                    Text="{Binding ErrorMessage}"
                    TextColor="{StaticResource Danger}" />
            </VerticalStackLayout>
        </Border>
    </controls:PageShell>
</ContentPage>
