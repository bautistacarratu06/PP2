<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="UI.Views.StudentsPage"
    x:DataType="vm:StudentsViewModel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:UI.Controls"
    xmlns:vm="clr-namespace:UI.ViewModels"
    Shell.NavBarIsVisible="False">

    <Grid>
        <controls:PageShell Title="Estudiantes" Subtitle="Nómina, riesgo, asistencias y entregas en una sola vista.">
            <VerticalStackLayout Spacing="20">
                <HorizontalStackLayout Spacing="8">
                    <Button Command="{Binding AddStudent.ShowCommand}" Style="{StaticResource PrimaryButton}" Text="Cargar estudiante" />
                    <Button Command="{Binding Import.OpenCommand}" Style="{StaticResource GhostButton}" Text="Cargar comisión" />
                    <Button
                        Command="{Binding Filters.ClearCommand}"
                        IsVisible="{Binding Filters.HasActiveFilters}"
                        Style="{StaticResource GhostButton}"
                        Text="Limpiar filtros" />
                </HorizontalStackLayout>

                <Border IsVisible="{Binding AddStudent.IsAdding}" Padding="20" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Label Style="{StaticResource CardTitle}" Text="Nuevo estudiante" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                            <VerticalStackLayout Spacing="6">
                                <Label Style="{StaticResource FieldLabel}" Text="Apellido" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Placeholder="Apellido" Text="{Binding AddStudent.LastName}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Style="{StaticResource FieldLabel}" Text="Nombre" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Placeholder="Nombre" Text="{Binding AddStudent.FirstName}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Spacing="6">
                                <Label Style="{StaticResource FieldLabel}" Text="Legajo" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry FontFamily="JetBrainsMono" Placeholder="Legajo" Text="{Binding AddStudent.StudentNumber}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Grid.Row="1" Spacing="6">
                                <Label Style="{StaticResource FieldLabel}" Text="DNI" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry FontFamily="JetBrainsMono" Placeholder="DNI" Text="{Binding AddStudent.Dni}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="2" Spacing="6">
                                <Label Style="{StaticResource FieldLabel}" Text="Fecha de incorporación" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <DatePicker Date="{Binding AddStudent.EnrolledOn}" Format="dd/MM/yyyy" MaximumDate="{Binding AddStudent.Today}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Grid.Row="2" Spacing="6">
                                <Label Style="{StaticResource FieldLabel}" Text="Teléfono" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry FontFamily="JetBrainsMono" Placeholder="Opcional" Text="{Binding AddStudent.Phone}" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                        <VerticalStackLayout Spacing="6">
                            <Label Style="{StaticResource FieldLabel}" Text="Correo" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Entry Placeholder="Opcional" Text="{Binding AddStudent.Email}" />
                            </Border>
                        </VerticalStackLayout>
                        <Label IsVisible="{Binding AddStudent.HasAddError}" Text="{Binding AddStudent.AddError}" TextColor="{StaticResource Danger}" />
                        <HorizontalStackLayout Spacing="8">
                            <Button Command="{Binding AddStudent.SaveCommand}" Style="{StaticResource PrimaryButton}" Text="Guardar" />
                            <Button Command="{Binding AddStudent.CancelCommand}" Style="{StaticResource GhostButton}" Text="Cancelar" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                    <controls:KpiCard
                        CaptionText="Riesgo alto"
                        Command="{Binding Filters.ToggleRiskCommand}"
                        CommandParameter="Alto"
                        IsActive="{Binding Filters.HighActive}"
                        Level="Alto"
                        Total="{Binding TotalCount}"
                        Value="{Binding HighRiskCount}" />
                    <controls:KpiCard
                        Grid.Column="1"
                        CaptionText="Riesgo medio"
                        Command="{Binding Filters.ToggleRiskCommand}"
                        CommandParameter="Medio"
                        IsActive="{Binding Filters.MediumActive}"
                        Level="Medio"
                        Total="{Binding TotalCount}"
                        Value="{Binding MediumRiskCount}" />
                    <controls:KpiCard
                        Grid.Column="2"
                        CaptionText="Riesgo bajo"
                        Command="{Binding Filters.ToggleRiskCommand}"
                        CommandParameter="Bajo"
                        IsActive="{Binding Filters.LowActive}"
                        Level="Bajo"
                        Total="{Binding TotalCount}"
                        Value="{Binding LowRiskCount}" />
                </Grid>

                <Label IsVisible="{Binding HasStatus}" Text="{Binding StatusMessage}" TextColor="{StaticResource Success}" />

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <Grid Padding="16,14" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <controls:SearchBox Text="{Binding SearchText}" />
                            <Label
                                Grid.Column="1"
                                Style="{StaticResource CountLabel}"
                                Text="{Binding TotalMatching, StringFormat='{0} estudiantes'}" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource Line}" />

                        <ScrollView Orientation="Horizontal">
                            <VerticalStackLayout MinimumWidthRequest="1480">
                                <Grid
                                    Padding="16,0"
                                    ColumnDefinitions="40,*,110,120,180,110,150,150,130,90"
                                    ColumnSpacing="10"
                                    HeightRequest="42">
                                    <CheckBox IsChecked="{Binding Selection.IsAllSelected}" VerticalOptions="Center" />
                                    <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                        <Label Style="{StaticResource ColumnHeader}" Text="ESTUDIANTE" />
                                        <Button Command="{Binding Filters.SortByColumnCommand}" CommandParameter="Name" Style="{StaticResource LinkButton}" Text="↕" />
                                        <Button Command="{Binding Filters.ToggleFilterColumnCommand}" CommandParameter="Name" Style="{StaticResource LinkButton}" Text="▾" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
                                        <Label Style="{StaticResource ColumnHeader}" Text="LEGAJO" />
                                        <Button Command="{Binding Filters.SortByColumnCommand}" CommandParameter="StudentNumber" Style="{StaticResource LinkButton}" Text="↕" />
                                        <Button Command="{Binding Filters.ToggleFilterColumnCommand}" CommandParameter="Legajo" Style="{StaticResource LinkButton}" Text="▾" />
                                    </HorizontalStackLayout>
                                    <Label Grid.Column="3" Style="{StaticResource ColumnHeader}" Text="TELÉFONO" VerticalOptions="Center" />
                                    <HorizontalStackLayout Grid.Column="4" Spacing="4" VerticalOptions="Center">
                                        <Label Style="{StaticResource ColumnHeader}" Text="CORREO" />
                                        <Button Command="{Binding Filters.ToggleFilterColumnCommand}" CommandParameter="Email" Style="{StaticResource LinkButton}" Text="▾" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Grid.Column="5" Spacing="4" VerticalOptions="Center">
                                        <Label Style="{StaticResource ColumnHeader}" Text="RIESGO" />
                                        <Button Command="{Binding Filters.SortByColumnCommand}" CommandParameter="Risk" Style="{StaticResource LinkButton}" Text="↕" />
                                        <Button Command="{Binding Filters.ToggleFilterColumnCommand}" CommandParameter="Risk" Style="{StaticResource LinkButton}" Text="▾" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Grid.Column="6" Spacing="4" VerticalOptions="Center">
                                        <Label Style="{StaticResource ColumnHeader}" Text="ASISTENCIA" />
                                        <Button Command="{Binding Filters.SortByColumnCommand}" CommandParameter="Attendance" Style="{StaticResource LinkButton}" Text="↕" />
                                        <Button Command="{Binding Filters.ToggleFilterColumnCommand}" CommandParameter="Attendance" Style="{StaticResource LinkButton}" Text="▾" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Grid.Column="7" Spacing="4" VerticalOptions="Center">
                                        <Label Style="{StaticResource ColumnHeader}" Text="ENTREGAS" />
                                        <Button Command="{Binding Filters.SortByColumnCommand}" CommandParameter="Delivery" Style="{StaticResource LinkButton}" Text="↕" />
                                        <Button Command="{Binding Filters.ToggleFilterColumnCommand}" CommandParameter="Delivery" Style="{StaticResource LinkButton}" Text="▾" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Grid.Column="8" Spacing="4" VerticalOptions="Center">
                                        <Label Style="{StaticResource ColumnHeader}" Text="CONTACTO" />
                                        <Button Command="{Binding Filters.ToggleFilterColumnCommand}" CommandParameter="Contact" Style="{StaticResource LinkButton}" Text="▾" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Grid.Column="9" Spacing="4" VerticalOptions="Center">
                                        <Label Style="{StaticResource ColumnHeader}" Text="ESTADO" />
                                        <Button Command="{Binding Filters.ToggleFilterColumnCommand}" CommandParameter="Active" Style="{StaticResource LinkButton}" Text="▾" />
                                    </HorizontalStackLayout>
                                </Grid>

                                <Border Margin="16,0,16,8" Padding="12" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 10" StrokeThickness="1">
                                    <Border.Triggers>
                                        <DataTrigger Binding="{Binding Filters.OpenFilterColumn}" TargetType="Border" Value="">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <VerticalStackLayout Spacing="10">
                                        <VerticalStackLayout IsVisible="False" Spacing="6">
                                            <VerticalStackLayout.Triggers>
                                                <DataTrigger Binding="{Binding Filters.OpenFilterColumn}" TargetType="VerticalStackLayout" Value="Name">
                                                    <Setter Property="IsVisible" Value="True" />
                                                </DataTrigger>
                                            </VerticalStackLayout.Triggers>
                                            <Label Style="{StaticResource FieldLabel}" Text="Estudiante contiene" />
                                            <Entry Placeholder="Apellido o nombre" Text="{Binding Filters.NameFilter}" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout IsVisible="False" Spacing="6">
                                            <VerticalStackLayout.Triggers>
                                                <DataTrigger Binding="{Binding Filters.OpenFilterColumn}" TargetType="VerticalStackLayout" Value="Legajo">
                                                    <Setter Property="IsVisible" Value="True" />
                                                </DataTrigger>
                                            </VerticalStackLayout.Triggers>
                                            <Label Style="{StaticResource FieldLabel}" Text="Legajo contiene" />
                                            <Entry FontFamily="JetBrainsMono" Placeholder="LEG-…" Text="{Binding Filters.LegajoFilter}" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout IsVisible="False" Spacing="6">
                                            <VerticalStackLayout.Triggers>
                                                <DataTrigger Binding="{Binding Filters.OpenFilterColumn}" TargetType="VerticalStackLayout" Value="Email">
                                                    <Setter Property="IsVisible" Value="True" />
                                                </DataTrigger>
                                            </VerticalStackLayout.Triggers>
                                            <Label Style="{StaticResource FieldLabel}" Text="Correo contiene" />
                                            <Entry Placeholder="correo@" Text="{Binding Filters.EmailFilter}" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout IsVisible="False" Spacing="6">
                                            <VerticalStackLayout.Triggers>
                                                <DataTrigger Binding="{Binding Filters.OpenFilterColumn}" TargetType="VerticalStackLayout" Value="Risk">
                                                    <Setter Property="IsVisible" Value="True" />
                                                </DataTrigger>
                                            </VerticalStackLayout.Triggers>
                                            <Label Style="{StaticResource FieldLabel}" Text="Riesgo" />
                                            <HorizontalStackLayout Spacing="12">
                                                <CheckBox IsChecked="{Binding Filters.FilterRiskAlto}" />
                                                <Label Text="Alto" VerticalOptions="Center" />
                                                <CheckBox IsChecked="{Binding Filters.FilterRiskMedio}" />
                                                <Label Text="Medio" VerticalOptions="Center" />
                                                <CheckBox IsChecked="{Binding Filters.FilterRiskBajo}" />
                                                <Label Text="Bajo" VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout IsVisible="False" Spacing="6">
                                            <VerticalStackLayout.Triggers>
                                                <DataTrigger Binding="{Binding Filters.OpenFilterColumn}" TargetType="VerticalStackLayout" Value="Attendance">
                                                    <Setter Property="IsVisible" Value="True" />
                                                </DataTrigger>
                                            </VerticalStackLayout.Triggers>
                                            <Label Style="{StaticResource FieldLabel}" Text="Asistencia %" />
                                            <HorizontalStackLayout Spacing="8">
                                                <Entry Keyboard="Numeric" Placeholder="Mín" Text="{Binding Filters.AttendanceMinText}" WidthRequest="80" />
                                                <Entry Keyboard="Numeric" Placeholder="Máx" Text="{Binding Filters.AttendanceMaxText}" WidthRequest="80" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout IsVisible="False" Spacing="6">
                                            <VerticalStackLayout.Triggers>
                                                <DataTrigger Binding="{Binding Filters.OpenFilterColumn}" TargetType="VerticalStackLayout" Value="Delivery">
                                                    <Setter Property="IsVisible" Value="True" />
                                                </DataTrigger>
                                            </VerticalStackLayout.Triggers>
                                            <Label Style="{StaticResource FieldLabel}" Text="Entregas %" />
                                            <HorizontalStackLayout Spacing="8">
                                                <Entry Keyboard="Numeric" Placeholder="Mín" Text="{Binding Filters.DeliveryMinText}" WidthRequest="80" />
                                                <Entry Keyboard="Numeric" Placeholder="Máx" Text="{Binding Filters.DeliveryMaxText}" WidthRequest="80" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout IsVisible="False" Spacing="6">
                                            <VerticalStackLayout.Triggers>
                                                <DataTrigger Binding="{Binding Filters.OpenFilterColumn}" TargetType="VerticalStackLayout" Value="Contact">
                                                    <Setter Property="IsVisible" Value="True" />
                                                </DataTrigger>
                                            </VerticalStackLayout.Triggers>
                                            <Label Style="{StaticResource FieldLabel}" Text="Contacto" />
                                            <HorizontalStackLayout Spacing="12">
                                                <CheckBox IsChecked="{Binding Filters.FilterContactSin}" />
                                                <Label Text="Sin contactar" VerticalOptions="Center" />
                                                <CheckBox IsChecked="{Binding Filters.FilterContactCon}" />
                                                <Label Text="Contactado" VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout IsVisible="False" Spacing="6">
                                            <VerticalStackLayout.Triggers>
                                                <DataTrigger Binding="{Binding Filters.OpenFilterColumn}" TargetType="VerticalStackLayout" Value="Active">
                                                    <Setter Property="IsVisible" Value="True" />
                                                </DataTrigger>
                                            </VerticalStackLayout.Triggers>
                                            <Label Style="{StaticResource FieldLabel}" Text="Estado" />
                                            <Picker SelectedItem="{Binding Filters.ActiveFilterKey}">
                                                <Picker.Items>
                                                    <x:String>Activos</x:String>
                                                    <x:String>Inactivos</x:String>
                                                    <x:String>Todos</x:String>
                                                </Picker.Items>
                                            </Picker>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>

                                <BoxView HeightRequest="1" Color="{StaticResource Line}" />
                                <ScrollView MaximumHeightRequest="560" Scrolled="OnRowsScrolled">
                                    <controls:GridLoadingView
                                        ErrorMessage="{Binding ErrorMessage}"
                                        HasError="{Binding HasError}"
                                        IsLoading="{Binding IsBusy}">
                                        <controls:GridLoadingView.SkeletonView>
                                            <controls:SkeletonGrid RowCount="6" RowHeight="64">
                                                <controls:SkeletonGrid.RowTemplate>
                                                    <DataTemplate>
                                                        <Grid
                                                            Padding="16,0"
                                                            ColumnDefinitions="40,*,110,120,180,110,150,150,130,90"
                                                            ColumnSpacing="10"
                                                            HeightRequest="64">
                                                            <controls:SkeletonBlock WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                                                            <HorizontalStackLayout Grid.Column="1" Spacing="12" VerticalOptions="Center">
                                                                <controls:SkeletonBlock WidthRequest="32" HeightRequest="32" IsCircle="True" />
                                                                <controls:SkeletonBlock WidthRequest="140" HeightRequest="14" />
                                                            </HorizontalStackLayout>
                                                            <controls:SkeletonBlock Grid.Column="2" WidthRequest="70" HeightRequest="12" VerticalOptions="Center" />
                                                            <controls:SkeletonBlock Grid.Column="3" WidthRequest="90" HeightRequest="12" VerticalOptions="Center" />
                                                            <controls:SkeletonBlock Grid.Column="4" WidthRequest="140" HeightRequest="12" VerticalOptions="Center" />
                                                            <controls:SkeletonBlock Grid.Column="5" WidthRequest="64" HeightRequest="22" Radius="11" VerticalOptions="Center" />
                                                            <controls:SkeletonBlock Grid.Column="6" WidthRequest="100" HeightRequest="8" VerticalOptions="Center" />
                                                            <controls:SkeletonBlock Grid.Column="7" WidthRequest="100" HeightRequest="8" VerticalOptions="Center" />
                                                            <controls:SkeletonBlock Grid.Column="8" WidthRequest="80" HeightRequest="12" VerticalOptions="Center" />
                                                            <controls:SkeletonBlock Grid.Column="9" WidthRequest="50" HeightRequest="12" VerticalOptions="Center" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </controls:SkeletonGrid.RowTemplate>
                                            </controls:SkeletonGrid>
                                        </controls:GridLoadingView.SkeletonView>

                                        <VerticalStackLayout>
                                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding FilteredStudents}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:StudentRow">
                                                        <VerticalStackLayout>
                                                            <controls:HoverRow
                                                                Padding="16,0"
                                                                ColumnDefinitions="40,*,110,120,180,110,150,150,130,90"
                                                                ColumnSpacing="10"
                                                                HeightRequest="64">
                                                                <CheckBox IsChecked="{Binding IsSelected}" VerticalOptions="Center" />
                                                                <HorizontalStackLayout
                                                                    Grid.Column="1"
                                                                    Spacing="12"
                                                                    VerticalOptions="Center">
                                                                    <HorizontalStackLayout.GestureRecognizers>
                                                                        <TapGestureRecognizer
                                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenCommand}"
                                                                            CommandParameter="{Binding .}" />
                                                                    </HorizontalStackLayout.GestureRecognizers>
                                                                    <controls:Avatar FullName="{Binding Name}" />
                                                                    <Label
                                                                        FontFamily="InterSemibold"
                                                                        FontSize="14"
                                                                        Text="{Binding Name}"
                                                                        VerticalOptions="Center"
                                                                        LineBreakMode="TailTruncation" />
                                                                </HorizontalStackLayout>
                                                                <Label
                                                                    Grid.Column="2"
                                                                    FontFamily="JetBrainsMono"
                                                                    FontSize="12"
                                                                    Text="{Binding StudentNumber}"
                                                                    VerticalOptions="Center" />
                                                                <Label
                                                                    Grid.Column="3"
                                                                    FontFamily="JetBrainsMono"
                                                                    FontSize="12"
                                                                    Text="{Binding Phone}"
                                                                    VerticalOptions="Center"
                                                                    LineBreakMode="TailTruncation" />
                                                                <Label
                                                                    Grid.Column="4"
                                                                    FontSize="13"
                                                                    Text="{Binding Email}"
                                                                    TextColor="{StaticResource TextSecondary}"
                                                                    VerticalOptions="Center"
                                                                    LineBreakMode="TailTruncation" />
                                                                <controls:RiskPill
                                                                    Grid.Column="5"
                                                                    Level="{Binding RiskLevel}"
                                                                    Score="{Binding RiskScore}"
                                                                    VerticalOptions="Center" />
                                                                <HorizontalStackLayout
                                                                    Grid.Column="6"
                                                                    Spacing="8"
                                                                    VerticalOptions="Center">
                                                                    <controls:Meter BarWidth="72" ShowLabel="False" Value="{Binding AttendanceRatio}" />
                                                                    <Label
                                                                        FontFamily="JetBrainsMono"
                                                                        FontSize="12"
                                                                        Text="{Binding AttendanceText}"
                                                                        VerticalOptions="Center" />
                                                                </HorizontalStackLayout>
                                                                <HorizontalStackLayout
                                                                    Grid.Column="7"
                                                                    Spacing="8"
                                                                    VerticalOptions="Center">
                                                                    <controls:Meter BarWidth="72" ShowLabel="False" Value="{Binding DeliveryRatio}" />
                                                                    <Label
                                                                        FontFamily="JetBrainsMono"
                                                                        FontSize="12"
                                                                        Text="{Binding DeliveryText}"
                                                                        VerticalOptions="Center" />
                                                                </HorizontalStackLayout>
                                                                <Label
                                                                    Grid.Column="8"
                                                                    FontSize="13"
                                                                    Text="{Binding ContactLabel}"
                                                                    VerticalOptions="Center"
                                                                    LineBreakMode="TailTruncation" />
                                                                <Label
                                                                    Grid.Column="9"
                                                                    FontSize="13"
                                                                    Text="{Binding ActiveLabel}"
                                                                    VerticalOptions="Center" />
                                                            </controls:HoverRow>
                                                            <BoxView HeightRequest="1" Color="{StaticResource Line}" />
                                                        </VerticalStackLayout>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>
                                            <Label IsVisible="{Binding ShowSearchEmpty}" Style="{StaticResource EmptyLabel}" Text="Sin resultados para esos filtros." />
                                            <ActivityIndicator
                                                Margin="0,12"
                                                HeightRequest="24"
                                                IsRunning="{Binding IsLoadingMore}"
                                                IsVisible="{Binding IsLoadingMore}" />
                                        </VerticalStackLayout>
                                    </controls:GridLoadingView>
                                </ScrollView>
                            </VerticalStackLayout>
                        </ScrollView>
                        <BoxView HeightRequest="1" Color="{StaticResource Line}" />
                        <Grid Padding="16,10" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label
                                IsVisible="{Binding HasLoadMoreError}"
                                Text="{Binding LoadMoreError}"
                                TextColor="{StaticResource Danger}"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                Style="{StaticResource CountLabel}"
                                Text="{Binding LoadedText}"
                                VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout IsVisible="{Binding ShowEmptyRoster}" Spacing="12" HorizontalOptions="Center">
                    <Label Style="{StaticResource EmptyLabel}" Text="Esta comisión todavía no tiene estudiantes." />
                    <Button Command="{Binding AddStudent.ShowCommand}" HorizontalOptions="Center" Style="{StaticResource PrimaryButton}" Text="Cargar estudiante" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </controls:PageShell>

        <controls:FloatingActionBar
            ClearSelectionCommand="{Binding Selection.ClearCommand}"
            IsActive="{Binding Selection.HasSelection}"
            SelectedCount="{Binding Selection.SelectedCount}"
            SelectedCountText="{Binding Selection.SelectedCountText}"
            VerticalOptions="End"
            Margin="0,0,0,24">
            <controls:FloatingActionBar.ActionsContent>
                <Button Command="{Binding Actions.OpenActionsCommand}" Style="{StaticResource PrimaryButton}" Text="Acciones" />
            </controls:FloatingActionBar.ActionsContent>
        </controls:FloatingActionBar>

        <!-- Modal Acciones -->
        <Grid BackgroundColor="#B30B0D13" IsVisible="{Binding Actions.IsActionsOpen}" InputTransparent="False">
            <Border
                BackgroundColor="{StaticResource Surface}"
                HorizontalOptions="Center"
                MaximumWidthRequest="520"
                Padding="24"
                Stroke="{StaticResource Line}"
                StrokeShape="RoundRectangle 14"
                StrokeThickness="1"
                VerticalOptions="Center"
                WidthRequest="480">
                <VerticalStackLayout Spacing="16">
                    <Label FontFamily="InterSemibold" FontSize="18" Text="Acciones" TextColor="{StaticResource TextPrimary}" />
                    <Label FontSize="13" Text="{Binding Selection.SelectedCountText}" TextColor="{StaticResource TextSecondary}" />

                    <VerticalStackLayout IsVisible="{Binding Actions.IsActionsStep1}" Spacing="12">
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Placeholder="Buscar acción…" Text="{Binding Actions.ActionSearchText}" />
                        </Border>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Actions.FilteredActions}" Spacing="4">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ActionPaletteItem">
                                    <Button
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.Actions.SelectActionCommand}"
                                        CommandParameter="{Binding .}"
                                        Style="{StaticResource GhostButton}"
                                        Text="{Binding Title}"
                                        HorizontalOptions="Fill" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding Actions.IsActionsStep2}" Spacing="12">
                        <VerticalStackLayout IsVisible="{Binding Actions.IsAttendanceAction}" Spacing="10">
                            <Label Style="{StaticResource FieldLabel}" Text="Clase" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Picker ItemsSource="{Binding Actions.ClassSessions}" SelectedItem="{Binding Actions.SelectedClassSession}" />
                            </Border>
                            <HorizontalStackLayout Spacing="8">
                                <Button Command="{Binding Actions.ConfirmAttendanceCommand}" CommandParameter="Presente" Style="{StaticResource PrimaryButton}" Text="Marcar Presente" />
                                <Button Command="{Binding Actions.ConfirmAttendanceCommand}" CommandParameter="Ausente" Style="{StaticResource GhostButton}" Text="Marcar Ausente" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <VerticalStackLayout IsVisible="{Binding Actions.IsSubmissionsAction}" Spacing="10">
                            <Label Style="{StaticResource FieldLabel}" Text="Trabajo" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Picker ItemsSource="{Binding Actions.Assignments}" SelectedItem="{Binding Actions.SelectedAssignment}" />
                            </Border>
                            <HorizontalStackLayout Spacing="8">
                                <Button Command="{Binding Actions.ConfirmSubmissionCommand}" CommandParameter="Entregó" Style="{StaticResource PrimaryButton}" Text="Marcar Entregó" />
                                <Button Command="{Binding Actions.ConfirmSubmissionCommand}" CommandParameter="No entregó" Style="{StaticResource GhostButton}" Text="Marcar No entregó" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <VerticalStackLayout IsVisible="{Binding Actions.IsDeactivateAction}" Spacing="10">
                            <Label FontSize="14" LineHeight="1.3" Text="{Binding Actions.DeactivateConfirmText}" TextColor="{StaticResource TextSecondary}" />
                            <Button Command="{Binding Actions.ConfirmDeactivateCommand}" Style="{StaticResource PrimaryButton}" Text="Confirmar desactivación" />
                        </VerticalStackLayout>

                        <HorizontalStackLayout Spacing="8">
                            <Button Command="{Binding Actions.BackToActionsCommand}" Style="{StaticResource GhostButton}" Text="Volver" />
                            <Button Command="{Binding Actions.CloseActionsCommand}" Style="{StaticResource LinkButton}" Text="Cancelar" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <Label IsVisible="{Binding Actions.HasActionError}" Text="{Binding Actions.ActionError}" TextColor="{StaticResource Danger}" />
                    <Button
                        Command="{Binding Actions.CloseActionsCommand}"
                        IsVisible="{Binding Actions.IsActionsStep1}"
                        Style="{StaticResource GhostButton}"
                        Text="Cancelar" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Wizard import comisión (mismo flujo que Nómina) -->
        <Grid
            x:Name="Wizard"
            x:DataType="vm:CommissionImportViewModel"
            BackgroundColor="#B30A0A0A"
            IsVisible="{Binding IsOpen}">
            <Border
                Padding="24"
                Style="{StaticResource Card}"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="640"
                MaximumHeightRequest="680"
                Margin="24">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">
                    <!-- Fila 0: Encabezado -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Style="{StaticResource PageTitle}" FontSize="22" Text="Cargar comisión" VerticalOptions="Center" />
                        <Button
                            Grid.Column="1"
                            Command="{Binding CancelCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            Style="{StaticResource GhostButton}"
                            Text="✕"
                            WidthRequest="36"
                            HeightRequest="36"
                            Padding="0" />
                    </Grid>

                    <!-- Fila 1: Contenido con Scroll -->
                    <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Default">
                        <VerticalStackLayout Spacing="16">
                            <!-- Paso 0: Archivo -->
                            <VerticalStackLayout IsVisible="{Binding IsFileStep}" Spacing="12">
                                <Label Style="{StaticResource PageSubtitle}" Text="Elegí el CSV con el botón o soltalo sobre este paso." />
                                <Border Padding="28,24" Style="{StaticResource FieldBorder}">
                                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                        <Label HorizontalTextAlignment="Center" Text="Soltá el CSV acá" TextColor="{StaticResource TextSecondary}" />
                                        <Label IsVisible="{Binding HasChosenFile}" FontFamily="JetBrainsMono" HorizontalTextAlignment="Center" Text="{Binding ChosenFileName}" />
                                        <Button Command="{Binding PickFileCommand}" IsEnabled="{Binding IsNotBusy}" HorizontalOptions="Center" Style="{StaticResource GhostButton}" Text="Seleccionar archivo" />
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Paso 1: Destino -->
                            <VerticalStackLayout IsVisible="{Binding IsDestinationStep}" Spacing="12">
                                <Label Style="{StaticResource FieldLabel}" Text="Comisión" />
                                <HorizontalStackLayout Spacing="8">
                                    <Button Clicked="OnNewCommission" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource GhostButton}" Text="Nueva" />
                                    <Button Clicked="OnExistingCommission" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource GhostButton}" Text="Existente" />
                                </HorizontalStackLayout>
                                <VerticalStackLayout IsVisible="{Binding CreateNew}" Spacing="6">
                                    <Label Style="{StaticResource FieldLabel}" Text="Nombre" />
                                    <Border Style="{StaticResource FieldBorder}">
                                        <Entry Placeholder="Hasta 20 caracteres" Text="{Binding NewName}" IsReadOnly="{Binding IsBusy}" />
                                    </Border>
                                </VerticalStackLayout>
                                <VerticalStackLayout IsVisible="{Binding ChooseExisting}" Spacing="6">
                                    <Label Style="{StaticResource FieldLabel}" Text="Comisión existente" />
                                    <Border Style="{StaticResource FieldBorder}">
                                        <Picker ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" IsEnabled="{Binding IsNotBusy}" />
                                    </Border>
                                </VerticalStackLayout>
                            </VerticalStackLayout>

                            <!-- Paso 2: Revisión de fusión u omisión -->
                            <VerticalStackLayout IsVisible="{Binding IsPreviewStep}" Spacing="12">
                                <Label FontFamily="InterSemibold" Text="{Binding InsertText}" />
                                <Label IsVisible="{Binding HasBlockedText}" Text="{Binding BlockedText}" TextColor="{StaticResource Warning}" />
                                <Label
                                    IsVisible="{Binding HasConflicts}"
                                    FontFamily="InterMedium"
                                    FontSize="13"
                                    Text="Revisión de registros existentes: seleccioná si deseás fusionar u omitir cada registro antes de confirmar."
                                    TextColor="{StaticResource TextSecondary}" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Conflicts}" Spacing="10">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ConflictChoice">
                                            <Border Padding="14" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 14" StrokeThickness="1">
                                                <VerticalStackLayout Spacing="8">
                                                    <Label FontFamily="InterSemibold" Text="{Binding Title}" />
                                                    <Label FontFamily="JetBrainsMono" FontSize="12" Text="{Binding Detail}" TextColor="{StaticResource TextSecondary}" />
                                                    <Label Text="{Binding Explanation}" TextColor="{StaticResource TextSecondary}" />
                                                    <HorizontalStackLayout Spacing="8">
                                                        <Button Command="{Binding ChooseOmitCommand}" Style="{StaticResource GhostButton}" Text="Omitir">
                                                            <Button.Triggers>
                                                                <DataTrigger Binding="{Binding Merge}" TargetType="Button" Value="False">
                                                                    <Setter Property="BackgroundColor" Value="{StaticResource AccentStrong}" />
                                                                    <Setter Property="TextColor" Value="{StaticResource White}" />
                                                                </DataTrigger>
                                                            </Button.Triggers>
                                                        </Button>
                                                        <Button Command="{Binding ChooseMergeCommand}" IsEnabled="{Binding CanMerge}" Style="{StaticResource GhostButton}" Text="Fusionar">
                                                            <Button.Triggers>
                                                                <DataTrigger Binding="{Binding Merge}" TargetType="Button" Value="True">
                                                                    <Setter Property="BackgroundColor" Value="{StaticResource AccentStrong}" />
                                                                    <Setter Property="TextColor" Value="{StaticResource White}" />
                                                                </DataTrigger>
                                                            </Button.Triggers>
                                                        </Button>
                                                    </HorizontalStackLayout>
                                                    <Label IsVisible="{Binding CannotMerge}" Text="Solo se puede omitir." TextColor="{StaticResource TextTertiary}" />
                                                </VerticalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </ScrollView>

                    <!-- Fila 2: Pie de acciones fijo -->
                    <VerticalStackLayout Grid.Row="2" Spacing="10">
                        <BoxView HeightRequest="1" Color="{StaticResource Line}" />
                        <Label IsVisible="{Binding HasError}" Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" />

                        <!-- Acciones Paso 0 y 1 -->
                        <HorizontalStackLayout IsVisible="{Binding IsNotPreviewStep}" Spacing="8">
                            <Button
                                Command="{Binding CancelCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Style="{StaticResource GhostButton}"
                                Text="Cancelar" />
                            <Button
                                Command="{Binding BackCommand}"
                                IsVisible="{Binding IsDestinationStep}"
                                IsEnabled="{Binding IsNotBusy}"
                                Style="{StaticResource GhostButton}"
                                Text="Atrás" />
                            <Button
                                Command="{Binding NextCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Style="{StaticResource PrimaryButton}"
                                Text="Siguiente" />
                        </HorizontalStackLayout>

                        <!-- Acciones Paso 2 (Revisión de fusión u omisión): ACEPTAR y CANCELAR -->
                        <HorizontalStackLayout IsVisible="{Binding IsPreviewStep}" Spacing="8">
                            <Button
                                Command="{Binding CancelCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Style="{StaticResource GhostButton}"
                                Text="Cancelar" />
                            <Button
                                Command="{Binding AcceptCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Style="{StaticResource PrimaryButton}"
                                Text="Aceptar" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
