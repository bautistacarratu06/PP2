<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="UI.Views.StudentListPage"
    x:DataType="vm:StudentListViewModel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:UI.ViewModels"
    BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#0F172A}"
    Shell.BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#0F172A}"
    Shell.ForegroundColor="{AppThemeBinding Light=#1A1D23, Dark=#E2E8F0}"
    Shell.NavBarIsVisible="False"
    Shell.NavBarHasShadow="False">

    <ContentPage.Resources>
        <Style x:Key="ColHeader" TargetType="Label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#667085, Dark=#94A3B8}" />
            <Setter Property="CharacterSpacing" Value="0.6" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
            <Setter Property="MaxLines" Value="1" />
        </Style>
    </ContentPage.Resources>

    <Grid
        x:Name="ContentHost"
        Padding="24,18,24,14"
        RowDefinitions="*"
        HorizontalOptions="Center"
        VerticalOptions="Fill"
        MaximumWidthRequest="1240">

        <Border
            x:Name="TableCard"
            Grid.Row="0"
            Padding="0"
            BackgroundColor="{AppThemeBinding Light=White, Dark=#111827}"
            Stroke="{AppThemeBinding Light=#E6E9F0, Dark=#334155}"
            StrokeShape="RoundRectangle 16"
            StrokeThickness="1"
            VerticalOptions="Fill">

            <ScrollView
                x:Name="TableScroll"
                HorizontalScrollBarVisibility="Default"
                Orientation="Horizontal"
                VerticalScrollBarVisibility="Never">

                <Grid
                    x:Name="TableRoot"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#111827}"
                    HorizontalOptions="Start"
                    MinimumWidthRequest="1120"
                    RowDefinitions="Auto,Auto,*"
                    VerticalOptions="Fill"
                    WidthRequest="1120">

                    <Label
                        Grid.Row="0"
                        Padding="20,18"
                        FontFamily="OpenSansSemibold"
                        FontSize="15"
                        Text="{Binding FilteredCount, StringFormat='{0} estudiantes'}"
                        TextColor="{AppThemeBinding Light=#1A1D23, Dark=#F8FAFC}" />

                    <VerticalStackLayout
                        Grid.Row="1"
                        Spacing="0">

                        <BoxView
                            HeightRequest="1"
                            Color="{AppThemeBinding Light=#EEF0F3, Dark=#334155}" />

                        <Grid
                            Padding="20,12"
                            BackgroundColor="{AppThemeBinding Light=#F8F9FB, Dark=#1E293B}"
                            ColumnDefinitions="110,*,180,250"
                            ColumnSpacing="8">

                            <Label Grid.Column="0" Style="{StaticResource ColHeader}" Text="LEGAJO" />
                            <Label Grid.Column="1" Style="{StaticResource ColHeader}" Text="APELLIDO Y NOMBRE" />
                            <Label Grid.Column="2" Style="{StaticResource ColHeader}" Text="TELÉFONO" />
                            <Label Grid.Column="3" Style="{StaticResource ColHeader}" Text="CORREO" />
                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            Color="{AppThemeBinding Light=#EEF0F3, Dark=#334155}" />
                    </VerticalStackLayout>

                    <CollectionView
                        x:Name="RowsView"
                        Grid.Row="2"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#111827}"
                        ItemsSource="{Binding FilteredStudents}"
                        SelectionMode="None">

                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout ItemSpacing="0" Orientation="Vertical" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.EmptyView>
                            <Label
                                Margin="0,28,0,0"
                                FontSize="14"
                                HorizontalOptions="Center"
                                Text="No hay estudiantes para mostrar."
                                TextColor="{AppThemeBinding Light=#8B93A7, Dark=#94A3B8}" />
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:StudentRow">
                                <VerticalStackLayout
                                    BackgroundColor="{AppThemeBinding Light=White, Dark=#111827}"
                                    Spacing="0">

                                    <Grid
                                        Padding="20,16"
                                        ColumnDefinitions="110,*,180,250"
                                        ColumnSpacing="8">

                                        <Label
                                            Grid.Column="0"
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            Text="{Binding LegajoLabel}"
                                            TextColor="{AppThemeBinding Light=#1A1D23, Dark=#F8FAFC}"
                                            VerticalOptions="Center" />

                                        <Label
                                            Grid.Column="1"
                                            FontFamily="OpenSansSemibold"
                                            FontSize="14"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="1"
                                            Text="{Binding Name}"
                                            TextColor="{AppThemeBinding Light=#1A1D23, Dark=#F8FAFC}"
                                            VerticalOptions="Center" />

                                        <Label
                                            Grid.Column="2"
                                            FontSize="14"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="1"
                                            Text="{Binding Phone}"
                                            TextColor="{AppThemeBinding Light=#1A1D23, Dark=#F8FAFC}"
                                            VerticalOptions="Center" />

                                        <Label
                                            Grid.Column="3"
                                            FontSize="14"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="1"
                                            Text="{Binding Email}"
                                            TextColor="{AppThemeBinding Light=#1A1D23, Dark=#F8FAFC}"
                                            VerticalOptions="Center" />
                                    </Grid>

                                    <BoxView
                                        HeightRequest="1"
                                        Color="{AppThemeBinding Light=#EEF0F3, Dark=#334155}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>
