<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="UI.Views.StudentListPage"
    x:DataType="vm:StudentListViewModel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:UI.ViewModels"
    BackgroundColor="#F4F6F8"
    Shell.BackgroundColor="#F4F6F8"
    Shell.ForegroundColor="#1A1D23"
    Shell.NavBarIsVisible="False"
    Shell.NavBarHasShadow="False">

    <ContentPage.Resources>
        <Style x:Key="ColHeader" TargetType="Label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextColor" Value="#667085" />
            <Setter Property="CharacterSpacing" Value="0.6" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
            <Setter Property="MaxLines" Value="1" />
        </Style>
    </ContentPage.Resources>

    <Grid
        x:Name="ContentHost"
        Padding="24,18,24,14"
        HorizontalOptions="Center"
        VerticalOptions="Fill"
        MaximumWidthRequest="1240">

        <!-- Tarjeta de la tabla -->
        <Border
            x:Name="TableCard"
            Padding="0"
            BackgroundColor="White"
            Stroke="#E6E9F0"
            StrokeShape="RoundRectangle 16"
            StrokeThickness="1"
            VerticalOptions="Fill">

            <ScrollView
                x:Name="TableScroll"
                HorizontalScrollBarVisibility="Default"
                Orientation="Horizontal"
                VerticalScrollBarVisibility="Never">

                <Grid
                    x:Name="TableRoot"
                    BackgroundColor="White"
                    HorizontalOptions="Start"
                    MinimumWidthRequest="1120"
                    RowDefinitions="Auto,Auto,*"
                    VerticalOptions="Fill"
                    WidthRequest="1120">

                    <!-- Título con contador -->
                    <Label
                        Grid.Row="0"
                        Padding="20,18"
                        FontFamily="OpenSansSemibold"
                        FontSize="15"
                        Text="{Binding FilteredCount, StringFormat='{0} estudiantes'}"
                        TextColor="#1A1D23" />

                    <!-- Encabezados -->
                    <VerticalStackLayout
                        Grid.Row="1"
                        Spacing="0">

                        <BoxView
                            HeightRequest="1"
                            Color="#EEF0F3" />

                        <Grid
                            Padding="20,12"
                            BackgroundColor="#F8F9FB"
                            ColumnDefinitions="110,*,180,250"
                            ColumnSpacing="8">

                            <Label Grid.Column="0" Style="{StaticResource ColHeader}" Text="LEGAJO" />
                            <Label Grid.Column="1" Style="{StaticResource ColHeader}" Text="APELLIDO Y NOMBRE" />
                            <Label Grid.Column="2" Style="{StaticResource ColHeader}" Text="TELÉFONO" />
                            <Label Grid.Column="3" Style="{StaticResource ColHeader}" Text="CORREO" />
                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            Color="#EEF0F3" />
                    </VerticalStackLayout>

                    <!-- Filas -->
                    <CollectionView
                        x:Name="RowsView"
                        Grid.Row="2"
                        BackgroundColor="White"
                        ItemsSource="{Binding FilteredStudents}"
                        SelectionMode="None">

                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout
                                ItemSpacing="0"
                                Orientation="Vertical" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.EmptyView>
                            <Label
                                Margin="0,28,0,0"
                                FontSize="14"
                                HorizontalOptions="Center"
                                Text="No hay estudiantes para mostrar."
                                TextColor="#8B93A7" />
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:StudentRow2">
                                <VerticalStackLayout BackgroundColor="White" Spacing="0">

                                    <Grid
                                        Padding="20,16"
                                        ColumnDefinitions="110,*,180,250"
                                        ColumnSpacing="8">

                                        <Label
                                            Grid.Column="0"
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            Text="{Binding LegajoLabel}"
                                            TextColor="#1A1D23"
                                            VerticalOptions="Center" />

                                        <Label
                                            Grid.Column="1"
                                            FontFamily="OpenSansSemibold"
                                            FontSize="14"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="1"
                                            Text="{Binding Name}"
                                            TextColor="#1A1D23"
                                            VerticalOptions="Center" />

                                        <Label
                                            Grid.Column="2"
                                            FontSize="14"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="1"
                                            Text="{Binding Phone}"
                                            TextColor="#1A1D23"
                                            VerticalOptions="Center" />

                                        <Label
                                            Grid.Column="3"
                                            FontSize="14"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="1"
                                            Text="{Binding Email}"
                                            TextColor="#1A1D23"
                                            VerticalOptions="Center" />
                                    </Grid>

                                    <BoxView
                                        HeightRequest="1"
                                        Color="#EEF0F3" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>