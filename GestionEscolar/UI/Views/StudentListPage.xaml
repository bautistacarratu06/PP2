<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="UI.Views.StudentListPage"
    x:DataType="vm:StudentListViewModel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:UI.Controls"
    xmlns:vm="clr-namespace:UI.ViewModels"
    Shell.NavBarIsVisible="False">

    <Grid>
        <controls:PageShell Title="Nómina" Subtitle="Estudiantes inscriptos en la comisión.">
            <VerticalStackLayout Spacing="16">
                <HorizontalStackLayout Spacing="8">
                    <Button Command="{Binding ShowAddCommand}" Style="{StaticResource PrimaryButton}" Text="Cargar estudiante" />
                    <Button Command="{Binding Import.OpenCommand}" Style="{StaticResource GhostButton}" Text="Cargar comisión" />
                </HorizontalStackLayout>

                <Border IsVisible="{Binding IsAdding}" Padding="20" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Label Style="{StaticResource CardTitle}" Text="Nuevo estudiante" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                            <VerticalStackLayout Spacing="6">
                                <Label Style="{StaticResource FieldLabel}" Text="Apellido" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Placeholder="Apellido" Text="{Binding LastName}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Style="{StaticResource FieldLabel}" Text="Nombre" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Placeholder="Nombre" Text="{Binding FirstName}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Spacing="6">
                                <Label Style="{StaticResource FieldLabel}" Text="Legajo" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry FontFamily="JetBrainsMono" Placeholder="Legajo" Text="{Binding StudentNumber}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Grid.Row="1" Spacing="6">
                                <Label Style="{StaticResource FieldLabel}" Text="DNI" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry FontFamily="JetBrainsMono" Placeholder="DNI" Text="{Binding Dni}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="2" Spacing="6">
                                <Label Style="{StaticResource FieldLabel}" Text="Fecha de incorporación" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <DatePicker Date="{Binding EnrolledOn}" Format="dd/MM/yyyy" MaximumDate="{Binding Today}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Grid.Row="2" Spacing="6">
                                <Label Style="{StaticResource FieldLabel}" Text="Teléfono" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry FontFamily="JetBrainsMono" Placeholder="Opcional" Text="{Binding Phone}" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                        <VerticalStackLayout Spacing="6">
                            <Label Style="{StaticResource FieldLabel}" Text="Correo" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Entry Placeholder="Opcional" Text="{Binding Email}" />
                            </Border>
                        </VerticalStackLayout>
                        <Label IsVisible="{Binding HasAddError}" Text="{Binding AddError}" TextColor="{StaticResource Danger}" />
                        <HorizontalStackLayout Spacing="8">
                            <Button Command="{Binding SaveStudentCommand}" Style="{StaticResource PrimaryButton}" Text="Guardar" />
                            <Button Command="{Binding CancelAddCommand}" Style="{StaticResource GhostButton}" Text="Cancelar" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border IsVisible="{Binding ShowTable}" Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <Grid Padding="16,14" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <controls:SearchBox Text="{Binding SearchText}" />
                            <Label
                                Grid.Column="1"
                                Style="{StaticResource CountLabel}"
                                Text="{Binding FilteredCount, StringFormat='{0} estudiantes'}" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource Line}" />
                        <Grid Padding="20,0" ColumnDefinitions="2.2*,130,150,2*" HeightRequest="38">
                            <Label Style="{StaticResource ColumnHeader}" Text="APELLIDO Y NOMBRE" />
                            <Label Grid.Column="1" Style="{StaticResource ColumnHeader}" Text="LEGAJO" />
                            <Label Grid.Column="2" Style="{StaticResource ColumnHeader}" Text="TELÉFONO" />
                            <Label Grid.Column="3" Style="{StaticResource ColumnHeader}" Text="CORREO" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource Line}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding FilteredStudents}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:StudentRow">
                                    <VerticalStackLayout>
                                        <controls:HoverRow
                                            Padding="20,0"
                                            ColumnDefinitions="2.2*,130,150,2*"
                                            ColumnSpacing="12"
                                            HeightRequest="64">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                                                <controls:Avatar FullName="{Binding Name}" />
                                                <Label
                                                    FontFamily="InterSemibold"
                                                    FontSize="14"
                                                    Text="{Binding Name}"
                                                    VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                            <Label Grid.Column="1" Style="{StaticResource Mono}" Text="{Binding StudentNumber}" />
                                            <Label Grid.Column="2" Style="{StaticResource Mono}" Text="{Binding Phone}" />
                                            <Label
                                                Grid.Column="3"
                                                FontSize="13"
                                                Text="{Binding Email}"
                                                TextColor="{StaticResource TextTertiary}"
                                                VerticalOptions="Center" />
                                        </controls:HoverRow>
                                        <BoxView HeightRequest="1" Color="{StaticResource Line}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Label
                            IsVisible="{Binding ShowSearchEmpty}"
                            Style="{StaticResource EmptyLabel}"
                            Text="{Binding EmptyText}" />
                        <Label
                            IsVisible="{Binding HasError}"
                            Padding="20,12"
                            Text="{Binding ErrorMessage}"
                            TextColor="{StaticResource Danger}" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout IsVisible="{Binding ShowEmptyRoster}" Spacing="12" HorizontalOptions="Center">
                    <Label Style="{StaticResource EmptyLabel}" Text="Esta comisión todavía no tiene estudiantes." />
                    <Button Command="{Binding ShowAddCommand}" HorizontalOptions="Center" Style="{StaticResource PrimaryButton}" Text="Cargar estudiante" />
                </VerticalStackLayout>
                <Label
                    IsVisible="{Binding HasError}"
                    Text="{Binding ErrorMessage}"
                    TextColor="{StaticResource Danger}" />
            </VerticalStackLayout>
        </controls:PageShell>

        <Grid
            x:Name="Wizard"
            x:DataType="vm:CommissionImportViewModel"
            BackgroundColor="{StaticResource Bg}"
            IsVisible="{Binding IsOpen}">
            <Border
                Padding="24"
                Style="{StaticResource Card}"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="640">
                <VerticalStackLayout Spacing="16">
                    <Label Style="{StaticResource PageTitle}" FontSize="22" Text="Cargar comisión" />

                    <VerticalStackLayout IsVisible="{Binding IsFileStep}" Spacing="12">
                        <Label Style="{StaticResource PageSubtitle}" Text="Elegí el CSV con el botón o soltalo sobre este paso." />
                        <Border Padding="28,24" Style="{StaticResource FieldBorder}">
                            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                <Label HorizontalTextAlignment="Center" Text="Soltá el CSV acá" TextColor="{StaticResource TextSecondary}" />
                                <Label
                                    IsVisible="{Binding HasChosenFile}"
                                    FontFamily="JetBrainsMono"
                                    HorizontalTextAlignment="Center"
                                    Text="{Binding ChosenFileName}" />
                                <Button Command="{Binding PickFileCommand}" HorizontalOptions="Center" Style="{StaticResource GhostButton}" Text="Seleccionar archivo" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding IsDestinationStep}" Spacing="12">
                        <Label Style="{StaticResource FieldLabel}" Text="Comisión" />
                        <HorizontalStackLayout Spacing="8">
                            <Button Clicked="OnNewCommission" Style="{StaticResource GhostButton}" Text="Nueva" />
                            <Button Clicked="OnExistingCommission" Style="{StaticResource GhostButton}" Text="Existente" />
                        </HorizontalStackLayout>
                        <VerticalStackLayout IsVisible="{Binding CreateNew}" Spacing="6">
                            <Label Style="{StaticResource FieldLabel}" Text="Nombre" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Entry Placeholder="Hasta 20 caracteres" Text="{Binding NewName}" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout IsVisible="{Binding ChooseExisting}" Spacing="6">
                            <Label Style="{StaticResource FieldLabel}" Text="Comisión existente" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Picker ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding IsPreviewStep}" Spacing="12">
                        <Label FontFamily="InterSemibold" Text="{Binding InsertText}" />
                        <Label Text="{Binding BlockedText}" TextColor="{StaticResource Warning}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Conflicts}" Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ConflictChoice">
                                    <Border Padding="14" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 12" StrokeThickness="1">
                                        <VerticalStackLayout Spacing="8">
                                            <Label FontFamily="InterSemibold" Text="{Binding Title}" />
                                            <Label FontFamily="JetBrainsMono" FontSize="12" Text="{Binding Detail}" TextColor="{StaticResource TextSecondary}" />
                                            <Label Text="{Binding Explanation}" TextColor="{StaticResource TextSecondary}" />
                                            <HorizontalStackLayout Spacing="8">
                                                <Button Command="{Binding ChooseOmitCommand}" Style="{StaticResource GhostButton}" Text="Omitir">
                                                    <Button.Triggers>
                                                        <DataTrigger Binding="{Binding Merge}" TargetType="Button" Value="False">
                                                            <Setter Property="BackgroundColor" Value="{StaticResource AccentStrong}" />
                                                            <Setter Property="TextColor" Value="{StaticResource White}" />
                                                        </DataTrigger>
                                                    </Button.Triggers>
                                                </Button>
                                                <Button Command="{Binding ChooseMergeCommand}" IsEnabled="{Binding CanMerge}" Style="{StaticResource GhostButton}" Text="Fusionar">
                                                    <Button.Triggers>
                                                        <DataTrigger Binding="{Binding Merge}" TargetType="Button" Value="True">
                                                            <Setter Property="BackgroundColor" Value="{StaticResource AccentStrong}" />
                                                            <Setter Property="TextColor" Value="{StaticResource White}" />
                                                        </DataTrigger>
                                                    </Button.Triggers>
                                                </Button>
                                            </HorizontalStackLayout>
                                            <Label IsVisible="{Binding CannotMerge}" Text="Solo se puede omitir." TextColor="{StaticResource TextTertiary}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <Label IsVisible="{Binding HasError}" Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" />
                    <HorizontalStackLayout Spacing="8">
                        <Button Command="{Binding BackCommand}" Style="{StaticResource GhostButton}" Text="Atrás" />
                        <Button Command="{Binding NextCommand}" Style="{StaticResource PrimaryButton}" Text="{Binding NextLabel}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
