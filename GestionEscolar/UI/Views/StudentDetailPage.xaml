<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="UI.Views.StudentDetailPage"
    x:DataType="vm:StudentDetailViewModel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:UI.Controls"
    xmlns:vm="clr-namespace:UI.ViewModels"
    Shell.NavBarIsVisible="False">

    <controls:PageShell
        BackCommand="{Binding BackCommand}"
        ShowBack="True"
        Subtitle="{Binding HeaderSubtitle}"
        Title="Detalle del alumno">
        <Grid x:Name="Columns" ColumnDefinitions="300,*" ColumnSpacing="16">
            <Border Padding="20" Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="0">
                    <HorizontalStackLayout Spacing="10">
                        <Label
                            FontFamily="InterSemibold"
                            FontSize="52"
                            Text="{Binding RiskScore}"
                            TextColor="{Binding RiskLevel, Converter={StaticResource RiskColor}}"
                            VerticalOptions="Center" />
                        <controls:RiskPill Level="{Binding RiskLevel}" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Border Margin="0,12,0,0" Padding="16,14" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 12" StrokeThickness="1">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label FontFamily="InterMedium" Text="Asistencia" />
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding AttendanceCaption}"
                                    TextColor="{StaticResource TextSecondary}" />
                            </Grid>
                            <controls:Meter BarHeight="6" BarWidth="260" ShowLabel="False" Value="{Binding AttendanceRatio}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Margin="0,12,0,0" Padding="16,14" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 12" StrokeThickness="1">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label FontFamily="InterMedium" Text="Entregas" />
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding SubmissionCaption}"
                                    TextColor="{StaticResource TextSecondary}" />
                            </Grid>
                            <controls:Meter BarHeight="6" BarWidth="260" ShowLabel="False" Value="{Binding SubmissionRatio}" />
                        </VerticalStackLayout>
                    </Border>

                    <Label Margin="0,14,0,0" CharacterSpacing="1" FontSize="11" Text="TELÉFONO" TextColor="{StaticResource TextTertiary}" />
                    <Label Text="{Binding Phone}" TextColor="{StaticResource Accent}" />
                    <Label Margin="0,14,0,0" CharacterSpacing="1" FontSize="11" Text="CORREO" TextColor="{StaticResource TextTertiary}" />
                    <Label LineBreakMode="WordWrap" Text="{Binding Email}" TextColor="{StaticResource Accent}" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout x:Name="History" Grid.Column="1" Spacing="16">
                <Label IsVisible="{Binding HasError}" Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" />
                <Border Padding="20" Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <Label Margin="0,0,0,8" Style="{StaticResource CardTitle}" Text="Historial de asistencia" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Attendance}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:HistoryItem">
                                    <Grid Padding="0,12" ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding Label}" VerticalOptions="Center" />
                                        <controls:StatusPill Grid.Column="1" Kind="{Binding Kind}" Text="{Binding Status}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Label IsVisible="{Binding HasNoAttendance}" Text="Sin clases registradas." TextColor="{StaticResource TextTertiary}" />
                    </VerticalStackLayout>
                </Border>
                <Border Padding="20" Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <Label Margin="0,0,0,8" Style="{StaticResource CardTitle}" Text="Historial de entregas" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Submissions}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:HistoryItem">
                                    <Grid Padding="0,12" ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding Label}" VerticalOptions="Center" />
                                        <controls:StatusPill Grid.Column="1" Kind="{Binding Kind}" Text="{Binding Status}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Label IsVisible="{Binding HasNoSubmissions}" Text="Sin trabajos registrados." TextColor="{StaticResource TextTertiary}" />
                    </VerticalStackLayout>
                </Border>
                <Border Padding="20" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Style="{StaticResource CardTitle}" Text="Intervenciones" VerticalOptions="Center" />
                            <Button
                                Grid.Column="1"
                                Command="{Binding OpenContactCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Text="Registrar contacto" />
                        </Grid>
                        <VerticalStackLayout IsVisible="{Binding IsContactOpen}" Spacing="10">
                            <VerticalStackLayout Spacing="6">
                                <Label Style="{StaticResource FieldLabel}" Text="Fecha" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <DatePicker Date="{Binding ContactDate}" Format="dd/MM/yyyy" MaximumDate="{Binding Today}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="6">
                                <Label Style="{StaticResource FieldLabel}" Text="Medio" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Picker ItemsSource="{Binding ChannelOptions}" SelectedItem="{Binding SelectedChannel}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="6">
                                <Label Style="{StaticResource FieldLabel}" Text="Resultado" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Picker ItemsSource="{Binding OutcomeOptions}" SelectedItem="{Binding SelectedOutcome}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="6">
                                <Label Style="{StaticResource FieldLabel}" Text="Nota" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Placeholder="Opcional" Text="{Binding Note}" />
                                </Border>
                            </VerticalStackLayout>
                            <Label IsVisible="{Binding HasContactError}" Text="{Binding ContactError}" TextColor="{StaticResource Danger}" />
                            <HorizontalStackLayout Spacing="8">
                                <Button Command="{Binding SaveContactCommand}" Style="{StaticResource PrimaryButton}" Text="Guardar" />
                                <Button Command="{Binding CancelContactCommand}" Style="{StaticResource GhostButton}" Text="Cancelar" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Interventions}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:HistoryItem">
                                    <Label Padding="0,12" Text="{Binding Label}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Label IsVisible="{Binding HasNoInterventions}" Text="Sin contactos registrados." TextColor="{StaticResource TextTertiary}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </Grid>
    </controls:PageShell>
</ContentPage>
