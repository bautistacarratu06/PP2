<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="UI.Views.CalendarPage"
    x:DataType="vm:CalendarViewModel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:UI.Controls"
    xmlns:vm="clr-namespace:UI.ViewModels"
    Shell.NavBarIsVisible="False">

    <controls:PageShell Title="Calendario" Subtitle="Clases y trabajos de la comisión.">
        <VerticalStackLayout Spacing="16">
            <Border Style="{StaticResource Card}">
                <Grid Padding="16,14" ColumnDefinitions="160,*,180,Auto" ColumnSpacing="12">
                    <Border Style="{StaticResource FieldBorder}">
                        <Picker ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding SelectedType}" />
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource FieldBorder}">
                        <Entry Placeholder="{Binding NamePlaceholder}" Text="{Binding NewName}" />
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource FieldBorder}">
                        <DatePicker Date="{Binding NewDate}" Format="dd/MM/yyyy" />
                    </Border>
                    <Button
                        Grid.Column="3"
                        Command="{Binding AddCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Text="Agregar" />
                </Grid>
            </Border>

            <Label IsVisible="{Binding HasError}" Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" />
            <Label IsVisible="{Binding HasStatus}" Text="{Binding StatusMessage}" TextColor="{StaticResource TextTertiary}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:CalendarRow">
                            <VerticalStackLayout>
                                <controls:HoverRow Padding="20,0" ColumnDefinitions="*,Auto,110" ColumnSpacing="12" HeightRequest="54">
                                    <Label FontFamily="InterSemibold" Text="{Binding Name}" VerticalOptions="Center" />
                                    <controls:StatusPill
                                        Grid.Column="1"
                                        Kind="{Binding KindKey}"
                                        Text="{Binding Kind}"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="2"
                                        FontFamily="JetBrainsMono"
                                        FontSize="12"
                                        HorizontalTextAlignment="End"
                                        Text="{Binding DateText}"
                                        TextColor="{StaticResource TextSecondary}"
                                        VerticalOptions="Center" />
                                </controls:HoverRow>
                                <BoxView HeightRequest="1" Color="{StaticResource Line}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Border.Triggers>
                    <DataTrigger Binding="{Binding HasNoItems}" TargetType="Border" Value="True">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Border.Triggers>
            </Border>
            <Label
                IsVisible="{Binding HasNoItems}"
                Style="{StaticResource EmptyLabel}"
                Text="Todavía no hay clases ni trabajos en esta comisión." />
        </VerticalStackLayout>
    </controls:PageShell>
</ContentPage>
