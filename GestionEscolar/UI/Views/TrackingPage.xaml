<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="UI.Views.TrackingPage"
    x:DataType="vm:TrackingViewModel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:UI.ViewModels"
    xmlns:conv="clr-namespace:UI.Converters"
    xmlns:models="clr-namespace:GestionEscolar.Core.Models;assembly=GestionEscolar.Core"
    BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#0F172A}"
    Shell.BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#0F172A}"
    Shell.ForegroundColor="{AppThemeBinding Light=#1A1D23, Dark=#E2E8F0}"
    Shell.NavBarIsVisible="False"
    Shell.NavBarHasShadow="False"
    SizeChanged="OnPageSizeChanged">

    <ContentPage.Resources>
        <conv:InvertBoolConverter x:Key="InvertBool" />
        <Style x:Key="ColHeader" TargetType="Label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#8B93A7, Dark=#94A3B8}" />
            <Setter Property="CharacterSpacing" Value="0.6" />
            <Setter Property="FontFamily" Value="OpenSansRegular" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
            <Setter Property="MaxLines" Value="2" />
        </Style>
    </ContentPage.Resources>

    <Grid
        x:Name="ContentHost"
        Padding="24,18,24,14"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="16"
        HorizontalOptions="Center"
        VerticalOptions="Fill"
        MaximumWidthRequest="1240">

        <!-- Encabezado: título + selector de comisión -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="12">
            <Label
                Grid.Column="0"
                FontFamily="OpenSansSemibold"
                FontSize="22"
                Text="Panel de seguimiento"
                TextColor="{AppThemeBinding Light=#1A1D23, Dark=#F8FAFC}"
                VerticalOptions="Center" />
            <HorizontalStackLayout
                Grid.Column="1"
                Spacing="10"
                VerticalOptions="Center">
                <Label
                    FontFamily="OpenSansRegular"
                    FontSize="13"
                    Text="Comisión"
                    TextColor="{AppThemeBinding Light=#5E6772, Dark=#94A3B8}"
                    VerticalOptions="Center" />
                <Border
                    Padding="10,0"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#111827}"
                    Stroke="{AppThemeBinding Light=#E6E9F0, Dark=#334155}"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="1">
                    <Picker
                        x:Name="SectionPicker"
                        MinimumWidthRequest="200"
                        BackgroundColor="Transparent"
                        FontFamily="OpenSansRegular"
                        FontSize="14"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}"
                        ItemDisplayBinding="{Binding Name, x:DataType=models:Section}"
                        ItemsSource="{Binding Sections}"
                        SelectedItem="{Binding SelectedSection}"
                        TextColor="{AppThemeBinding Light=#1A1D23, Dark=#F8FAFC}"
                        Title="Elegí una comisión"
                        TitleColor="{AppThemeBinding Light=#8B93A7, Dark=#94A3B8}" />
                </Border>
                <ActivityIndicator
                    HeightRequest="18"
                    WidthRequest="18"
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    Color="{AppThemeBinding Light=#0F766E, Dark=#5EEAD4}" />
            </HorizontalStackLayout>
        </Grid>

        <!-- Tarjetas de resumen: 3 columnas iguales (Alto / Medio / Bajo) -->
        <Grid
            Grid.Row="1"
            ColumnDefinitions="*,*,*"
            ColumnSpacing="12">
            <Border
                Grid.Column="0"
                Padding="18,16"
                BackgroundColor="{AppThemeBinding Light=#FDECEC, Dark=#3B1F1F}"
                Stroke="{AppThemeBinding Light=#F3C7C7, Dark=#7F3A3A}"
                StrokeShape="RoundRectangle 14"
                StrokeThickness="1">
                <VerticalStackLayout Spacing="6">
                    <Label
                        FontFamily="OpenSansRegular"
                        FontSize="13"
                        Text="Riesgo Alto"
                        TextColor="#E23D3D" />
                    <Label
                        FontFamily="OpenSansSemibold"
                        FontSize="34"
                        Text="{Binding HighRiskCount}"
                        TextColor="{AppThemeBinding Light=#1A1D23, Dark=#F8FAFC}" />
                </VerticalStackLayout>
            </Border>

            <Border
                Grid.Column="1"
                Padding="18,16"
                BackgroundColor="{AppThemeBinding Light=#FFF8E6, Dark=#3A2E1F}"
                Stroke="{AppThemeBinding Light=#F0E0B0, Dark=#8C6B2E}"
                StrokeShape="RoundRectangle 14"
                StrokeThickness="1">
                <VerticalStackLayout Spacing="6">
                    <Label
                        FontFamily="OpenSansRegular"
                        FontSize="13"
                        Text="Riesgo Medio"
                        TextColor="#C9841A" />
                    <Label
                        FontFamily="OpenSansSemibold"
                        FontSize="34"
                        Text="{Binding MediumRiskCount}"
                        TextColor="{AppThemeBinding Light=#1A1D23, Dark=#F8FAFC}" />
                </VerticalStackLayout>
            </Border>

            <Border
                Grid.Column="2"
                Padding="18,16"
                BackgroundColor="{AppThemeBinding Light=#E9F8EF, Dark=#183D2B}"
                Stroke="{AppThemeBinding Light=#C8EBD4, Dark=#2B6A57}"
                StrokeShape="RoundRectangle 14"
                StrokeThickness="1">
                <VerticalStackLayout Spacing="6">
                    <Label
                        FontFamily="OpenSansRegular"
                        FontSize="13"
                        Text="Riesgo Bajo"
                        TextColor="#1E9D57" />
                    <Label
                        FontFamily="OpenSansSemibold"
                        FontSize="34"
                        Text="{Binding LowRiskCount}"
                        TextColor="{AppThemeBinding Light=#1A1D23, Dark=#F8FAFC}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Border
            x:Name="TableCard"
            Grid.Row="2"
            Padding="0"
            BackgroundColor="{AppThemeBinding Light=White, Dark=#111827}"
            SizeChanged="OnTableViewportChanged"
            Stroke="{AppThemeBinding Light=#E6E9F0, Dark=#334155}"
            StrokeShape="RoundRectangle 16"
            StrokeThickness="1"
            VerticalOptions="Fill">
            <ScrollView
                x:Name="TableScroll"
                HorizontalScrollBarVisibility="Default"
                Orientation="Horizontal"
                SizeChanged="OnTableViewportChanged"
                VerticalScrollBarVisibility="Never">
                <Grid
                    x:Name="TableRoot"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#111827}"
                    HorizontalOptions="Start"
                    MinimumWidthRequest="1120"
                    RowDefinitions="Auto,*"
                    VerticalOptions="Start"
                    WidthRequest="1120">
                    <VerticalStackLayout x:Name="HeaderHost" Grid.Row="0" Spacing="0">
                        <Grid
                            x:Name="HeaderGrid"
                            Padding="16,12"
                            ColumnDefinitions="44,176,120,72,96,96,*,150"
                            ColumnSpacing="8"
                            HorizontalOptions="Start"
                            WidthRequest="{Binding Source={x:Reference TableRoot}, Path=WidthRequest}">
                            <Label Grid.Column="0" Style="{StaticResource ColHeader}" Text="#" />
                            <Label Grid.Column="1" Style="{StaticResource ColHeader}" Text="ESTUDIANTE" />
                            <Label Grid.Column="2" Style="{StaticResource ColHeader}" Text="NIVEL" />
                            <Label Grid.Column="3" Style="{StaticResource ColHeader}" Text="RIESGO" />
                            <Label Grid.Column="4" Style="{StaticResource ColHeader}" Text="ASISTENCIA" />
                            <Label Grid.Column="5" Style="{StaticResource ColHeader}" Text="ENTREGAS" />
                            <Label Grid.Column="6" Style="{StaticResource ColHeader}" Text="DETALLE QUE JUSTIFICA EL VALOR" />
                            <Label
                                Grid.Column="7"
                                HorizontalTextAlignment="End"
                                Style="{StaticResource ColHeader}"
                                Text="ÚLTIMO CONTACTO" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#EEF0F3, Dark=#334155}" />
                    </VerticalStackLayout>

                    <CollectionView
                        x:Name="RowsView"
                        Grid.Row="1"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#111827}"
                        HorizontalOptions="Fill"
                        ItemSizingStrategy="MeasureAllItems"
                        ItemsSource="{Binding FilteredStudents}"
                        SelectionMode="None"
                        SemanticProperties.Description="{Binding FilteredCount, StringFormat='{}{0} estudiantes'}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout ItemSpacing="0" Orientation="Vertical" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.EmptyView>
                            <Label
                                Margin="0,28,0,0"
                                FontSize="14"
                                HorizontalOptions="Center"
                                Text="No hay estudiantes para este filtro."
                                TextColor="{AppThemeBinding Light=#8B93A7, Dark=#94A3B8}" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:StudentRow">
                                <VerticalStackLayout BackgroundColor="{AppThemeBinding Light=White, Dark=#111827}">
                                    <VerticalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnStudentRowTapped" />
                                    </VerticalStackLayout.GestureRecognizers>
                                    <Grid
                                        Padding="16,14"
                                        ColumnDefinitions="44,176,120,72,96,96,*,150"
                                        ColumnSpacing="8"
                                        HorizontalOptions="Start"
                                        MinimumWidthRequest="1120"
                                        WidthRequest="{Binding Source={x:Reference TableRoot}, Path=WidthRequest}">
                                        <Label
                                            Grid.Column="0"
                                            FontSize="13"
                                            Text="{Binding RowNumber}"
                                            TextColor="{AppThemeBinding Light=#98A2B3, Dark=#94A3B8}"
                                            VerticalOptions="Center" />
                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Spacing="1"
                                            VerticalOptions="Center">
                                            <Label
                                                FontFamily="OpenSansSemibold"
                                                FontSize="14"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="1"
                                                Text="{Binding Name}"
                                                TextColor="{AppThemeBinding Light=#1A1D23, Dark=#F8FAFC}" />
                                            <Label
                                                FontSize="12"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="1"
                                                Text="{Binding LegajoLabel}"
                                                TextColor="{AppThemeBinding Light=#98A2B3, Dark=#94A3B8}" />
                                        </VerticalStackLayout>
                                        <Border
                                            Grid.Column="2"
                                            Padding="8,3"
                                            BackgroundColor="{Binding BadgeBackground}"
                                            HorizontalOptions="Start"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 10"
                                            StrokeThickness="0"
                                            VerticalOptions="Center">
                                            <HorizontalStackLayout Spacing="5">
                                                <Label
                                                    FontFamily="OpenSansSemibold"
                                                    FontSize="12"
                                                    Text="{Binding RiskLevel}"
                                                    TextColor="{Binding BadgeForeground}"
                                                    VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Border>
                                        <Label
                                            Grid.Column="3"
                                            FontFamily="OpenSansSemibold"
                                            FontSize="20"
                                            Text="{Binding RiskScore}"
                                            TextColor="{AppThemeBinding Light=#1A1D23, Dark=#F8FAFC}"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="4"
                                            FontSize="14"
                                            Text="{Binding AttendanceText}"
                                            TextColor="{AppThemeBinding Light=#1A1D23, Dark=#F8FAFC}"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="5"
                                            FontSize="14"
                                            Text="{Binding DeliveryText}"
                                            TextColor="{AppThemeBinding Light=#1A1D23, Dark=#F8FAFC}"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="6"
                                            FontSize="12"
                                            LineBreakMode="WordWrap"
                                            LineHeight="1.25"
                                            MaxLines="2"
                                            Text="{Binding Justification}"
                                            TextColor="{AppThemeBinding Light=#8B93A7, Dark=#94A3B8}"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="7"
                                            FontSize="13"
                                            HorizontalTextAlignment="End"
                                            Text="{Binding ContactLabel}"
                                            TextColor="{AppThemeBinding Light=#8B93A7, Dark=#94A3B8}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#EEF0F3, Dark=#334155}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>
