<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="UI.Views.TrackingPage"
    x:DataType="vm:TrackingViewModel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:UI.Controls"
    xmlns:vm="clr-namespace:UI.ViewModels"
    Shell.NavBarIsVisible="False">

    <controls:PageShell Title="Seguimiento" Subtitle="Riesgo de abandono por estudiante, según asistencia y entregas.">
        <VerticalStackLayout Spacing="24">
            <Grid x:Name="Kpis" ColumnDefinitions="*,*,*" ColumnSpacing="16">
                <controls:KpiCard
                    x:Name="HighCard"
                    CaptionText="Riesgo alto"
                    Command="{Binding ToggleRiskCommand}"
                    CommandParameter="Alto"
                    IsActive="{Binding HighActive}"
                    Level="Alto"
                    Total="{Binding TotalCount}"
                    Value="{Binding HighRiskCount}" />
                <controls:KpiCard
                    x:Name="MediumCard"
                    Grid.Column="1"
                    CaptionText="Riesgo medio"
                    Command="{Binding ToggleRiskCommand}"
                    CommandParameter="Medio"
                    IsActive="{Binding MediumActive}"
                    Level="Medio"
                    Total="{Binding TotalCount}"
                    Value="{Binding MediumRiskCount}" />
                <controls:KpiCard
                    x:Name="LowCard"
                    Grid.Column="2"
                    CaptionText="Riesgo bajo"
                    Command="{Binding ToggleRiskCommand}"
                    CommandParameter="Bajo"
                    IsActive="{Binding LowActive}"
                    Level="Bajo"
                    Total="{Binding TotalCount}"
                    Value="{Binding LowRiskCount}" />
            </Grid>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout>
                    <Grid Padding="16,14" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                        <controls:SearchBox Text="{Binding SearchText}" />
                        <controls:FilterChips Grid.Column="1" SelectedKey="{Binding SelectedRisk}" />
                        <Label
                            Grid.Column="2"
                            Style="{StaticResource CountLabel}"
                            Text="{Binding FilteredCount, StringFormat='{0} estudiantes'}" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource Line}" />
                    <Grid Padding="20,0" ColumnDefinitions="2.2*,110,1.3*,1.3*,110" HeightRequest="38">
                        <Label Style="{StaticResource ColumnHeader}" Text="ESTUDIANTE" />
                        <Label Grid.Column="1" Style="{StaticResource ColumnHeader}" Text="RIESGO" />
                        <Label Grid.Column="2" Style="{StaticResource ColumnHeader}" Text="ASISTENCIA" />
                        <Label Grid.Column="3" Style="{StaticResource ColumnHeader}" Text="ENTREGAS" />
                        <Label Grid.Column="4" Style="{StaticResource ColumnHeader}" Text="CONTACTO" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource Line}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding FilteredStudents}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:StudentRow">
                                <VerticalStackLayout>
                                    <controls:HoverRow
                                        Padding="20,0"
                                        ColumnDefinitions="2.2*,110,1.3*,1.3*,110"
                                        ColumnSpacing="12"
                                        HeightRequest="64">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                            <HorizontalStackLayout Spacing="12">
                                                <controls:Avatar FullName="{Binding Name}" />
                                                <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                                    <Label FontFamily="InterSemibold" FontSize="14" Text="{Binding Name}" />
                                                    <Label
                                                        FontFamily="JetBrainsMono"
                                                        FontSize="11"
                                                        Text="{Binding StudentNumber}"
                                                        TextColor="{StaticResource TextTertiary}" />
                                                </VerticalStackLayout>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                        <controls:RiskPill Grid.Column="1" Level="{Binding RiskLevel}" Score="{Binding RiskScore}" VerticalOptions="Center" />
                                        <controls:Meter Grid.Column="2" Value="{Binding AttendanceRatio}" VerticalOptions="Center" />
                                        <controls:Meter Grid.Column="3" Value="{Binding DeliveryRatio}" VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="4"
                                            FontSize="13"
                                            Text="{Binding ContactLabel}"
                                            TextColor="{StaticResource TextPrimary}"
                                            VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger Binding="{Binding HasContact}" TargetType="Label" Value="False">
                                                    <Setter Property="TextColor" Value="{StaticResource TextTertiary}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </controls:HoverRow>
                                    <BoxView HeightRequest="1" Color="{StaticResource Line}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label IsVisible="{Binding HasNoResults}" Style="{StaticResource EmptyLabel}" Text="Sin resultados para esa búsqueda." />
                    <Label
                        IsVisible="{Binding HasError}"
                        Padding="20,12"
                        Text="{Binding ErrorMessage}"
                        TextColor="{StaticResource Danger}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </controls:PageShell>
</ContentPage>
