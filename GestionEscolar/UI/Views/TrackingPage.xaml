<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="UI.Views.TrackingPage"
    x:DataType="vm:TrackingViewModel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:UI.ViewModels"
    BackgroundColor="#F4F6F8"
    Shell.BackgroundColor="#F4F6F8"
    Shell.ForegroundColor="#1A1D23"
    Shell.NavBarIsVisible="False"
    Shell.NavBarHasShadow="False"
    SizeChanged="OnPageSizeChanged">

    <ContentPage.Resources>
        <Style x:Key="ColHeader" TargetType="Label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextColor" Value="#8B93A7" />
            <Setter Property="CharacterSpacing" Value="0.6" />
            <Setter Property="FontFamily" Value="OpenSansRegular" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
            <Setter Property="MaxLines" Value="2" />
        </Style>
    </ContentPage.Resources>

    <Grid
        x:Name="ContentHost"
        Padding="24,18,24,14"
        RowDefinitions="Auto,*"
        RowSpacing="16"
        HorizontalOptions="Center"
        VerticalOptions="Fill"
        MaximumWidthRequest="1240">

        <FlexLayout
            Grid.Row="0"
            Margin="-6,0,-6,0"
            AlignContent="Start"
            AlignItems="Stretch"
            Direction="Row"
            JustifyContent="SpaceBetween"
            Wrap="Wrap">
            <Border
                Margin="6"
                Padding="18,16"
                BackgroundColor="#FDECEC"
                FlexLayout.Basis="31%"
                FlexLayout.Grow="1"
                MinimumWidthRequest="210"
                Stroke="#F3C7C7"
                StrokeShape="RoundRectangle 14"
                StrokeThickness="1">
                <VerticalStackLayout Spacing="6">
                    <Label
                        FontFamily="OpenSansRegular"
                        FontSize="13"
                        Text="Riesgo Alto"
                        TextColor="#8B93A7" />
                    <Label
                        FontFamily="OpenSansSemibold"
                        FontSize="34"
                        Text="{Binding HighRiskCount}"
                        TextColor="#1A1D23" />
                </VerticalStackLayout>
            </Border>

            <Border
                Margin="6"
                Padding="18,16"
                BackgroundColor="#FFF8E6"
                FlexLayout.Basis="31%"
                FlexLayout.Grow="1"
                MinimumWidthRequest="210"
                Stroke="#F0E0B0"
                StrokeShape="RoundRectangle 14"
                StrokeThickness="1">
                <VerticalStackLayout Spacing="6">
                    <Label
                        FontFamily="OpenSansRegular"
                        FontSize="13"
                        Text="Riesgo Medio"
                        TextColor="#8B93A7" />
                    <Label
                        FontFamily="OpenSansSemibold"
                        FontSize="34"
                        Text="{Binding MediumRiskCount}"
                        TextColor="#1A1D23" />
                </VerticalStackLayout>
            </Border>

            <Border
                Margin="6"
                Padding="18,16"
                BackgroundColor="#E9F8EF"
                FlexLayout.Basis="31%"
                FlexLayout.Grow="1"
                MinimumWidthRequest="210"
                Stroke="#C8EBD4"
                StrokeShape="RoundRectangle 14"
                StrokeThickness="1">
                <VerticalStackLayout Spacing="6">
                    <Label
                        FontFamily="OpenSansRegular"
                        FontSize="13"
                        Text="Riesgo Bajo"
                        TextColor="#8B93A7" />
                    <Label
                        FontFamily="OpenSansSemibold"
                        FontSize="34"
                        Text="{Binding LowRiskCount}"
                        TextColor="#1A1D23" />
                </VerticalStackLayout>
            </Border>
        </FlexLayout>

        <Border
            x:Name="TableCard"
            Grid.Row="1"
            Padding="0"
            BackgroundColor="White"
            SizeChanged="OnTableViewportChanged"
            Stroke="#E6E9F0"
            StrokeShape="RoundRectangle 16"
            StrokeThickness="1"
            VerticalOptions="Fill">
            <ScrollView
                x:Name="TableScroll"
                HorizontalScrollBarVisibility="Default"
                Orientation="Horizontal"
                SizeChanged="OnTableViewportChanged"
                VerticalScrollBarVisibility="Never">
                <Grid
                    x:Name="TableRoot"
                    BackgroundColor="White"
                    HorizontalOptions="Start"
                    MinimumWidthRequest="1120"
                    RowDefinitions="Auto,*"
                    VerticalOptions="Start"
                    WidthRequest="1120">
                    <VerticalStackLayout x:Name="HeaderHost" Grid.Row="0" Spacing="0">
                        <Grid
                            x:Name="HeaderGrid"
                            Padding="16,12"
                            ColumnDefinitions="44,176,120,72,96,96,*,150"
                            ColumnSpacing="8"
                            HorizontalOptions="Start"
                            WidthRequest="{Binding Source={x:Reference TableRoot}, Path=WidthRequest}">
                            <Label Grid.Column="0" Style="{StaticResource ColHeader}" Text="#" />
                            <Label Grid.Column="1" Style="{StaticResource ColHeader}" Text="ESTUDIANTE" />
                            <Label Grid.Column="2" Style="{StaticResource ColHeader}" Text="NIVEL" />
                            <Label Grid.Column="3" Style="{StaticResource ColHeader}" Text="RIESGO" />
                            <Label Grid.Column="4" Style="{StaticResource ColHeader}" Text="ASISTENCIA" />
                            <Label Grid.Column="5" Style="{StaticResource ColHeader}" Text="ENTREGAS" />
                            <Label Grid.Column="6" Style="{StaticResource ColHeader}" Text="DETALLE QUE JUSTIFICA EL VALOR" />
                            <Label
                                Grid.Column="7"
                                HorizontalTextAlignment="End"
                                Style="{StaticResource ColHeader}"
                                Text="ÚLTIMO CONTACTO" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#EEF0F3" />
                    </VerticalStackLayout>

                    <CollectionView
                        x:Name="RowsView"
                        Grid.Row="1"
                        BackgroundColor="White"
                        HorizontalOptions="Fill"
                        ItemSizingStrategy="MeasureAllItems"
                        ItemsSource="{Binding FilteredStudents}"
                        SelectionMode="None"
                        SemanticProperties.Description="{Binding FilteredCount, StringFormat='{}{0} estudiantes'}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout ItemSpacing="0" Orientation="Vertical" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.EmptyView>
                            <Label
                                Margin="0,28,0,0"
                                FontSize="14"
                                HorizontalOptions="Center"
                                Text="No hay estudiantes para este filtro."
                                TextColor="#8B93A7" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:StudentRow">
                                <VerticalStackLayout BackgroundColor="White">
                                    <Grid
                                        Padding="16,14"
                                        ColumnDefinitions="44,176,120,72,96,96,*,150"
                                        ColumnSpacing="8"
                                        HorizontalOptions="Start"
                                        MinimumWidthRequest="1120"
                                        WidthRequest="{Binding Source={x:Reference TableRoot}, Path=WidthRequest}">
                                        <Label
                                            Grid.Column="0"
                                            FontSize="13"
                                            Text="{Binding RowNumber}"
                                            TextColor="#98A2B3"
                                            VerticalOptions="Center" />
                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Spacing="1"
                                            VerticalOptions="Center">
                                            <Label
                                                FontFamily="OpenSansSemibold"
                                                FontSize="14"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="1"
                                                Text="{Binding Name}"
                                                TextColor="#1A1D23" />
                                            <Label
                                                FontSize="12"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="1"
                                                Text="{Binding LegajoLabel}"
                                                TextColor="#98A2B3" />
                                        </VerticalStackLayout>
                                        <Border
                                            Grid.Column="2"
                                            Padding="8,3"
                                            BackgroundColor="{Binding BadgeBackground}"
                                            HorizontalOptions="Start"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 10"
                                            StrokeThickness="0"
                                            VerticalOptions="Center">
                                            <HorizontalStackLayout Spacing="5">
                                                <Label
                                                    FontSize="9"
                                                    Text="{Binding BadgeGlyph}"
                                                    TextColor="{Binding BadgeForeground}"
                                                    VerticalOptions="Center" />
                                                <Label
                                                    FontFamily="OpenSansSemibold"
                                                    FontSize="12"
                                                    Text="{Binding RiskLevel}"
                                                    TextColor="{Binding BadgeForeground}"
                                                    VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Border>
                                        <Label
                                            Grid.Column="3"
                                            FontFamily="OpenSansSemibold"
                                            FontSize="20"
                                            Text="{Binding RiskScore}"
                                            TextColor="#1A1D23"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="4"
                                            FontSize="14"
                                            Text="{Binding AttendanceText}"
                                            TextColor="#1A1D23"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="5"
                                            FontSize="14"
                                            Text="{Binding DeliveryText}"
                                            TextColor="#1A1D23"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="6"
                                            FontSize="12"
                                            LineBreakMode="WordWrap"
                                            LineHeight="1.25"
                                            MaxLines="2"
                                            Text="{Binding Justification}"
                                            TextColor="#8B93A7"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="7"
                                            FontSize="13"
                                            HorizontalTextAlignment="End"
                                            Text="{Binding ContactLabel}"
                                            TextColor="#8B93A7"
                                            VerticalOptions="Center" />
                                    </Grid>
                                    <BoxView HeightRequest="1" Color="#EEF0F3" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>
