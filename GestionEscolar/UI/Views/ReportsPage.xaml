<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="UI.Views.ReportsPage"
    x:DataType="vm:ReportsViewModel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:UI.Controls"
    xmlns:vm="clr-namespace:UI.ViewModels"
    Shell.NavBarIsVisible="False">

    <controls:PageShell Title="Reportes" Subtitle="Resumen de riesgo de la comisión.">
        <VerticalStackLayout Spacing="16">
            <HorizontalStackLayout Spacing="12">
                <Button
                    Command="{Binding ExportCommand}"
                    Style="{StaticResource GhostButton}"
                    Text="Descargar reporte" />
            </HorizontalStackLayout>

            <Label IsVisible="{Binding HasError}" Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" />
            <Label IsVisible="{Binding HasStatus}" Text="{Binding StatusMessage}" TextColor="{StaticResource TextTertiary}" />

            <!-- Texto del reporte a la izquierda; los indicadores de riesgo apilados a la derecha. -->
            <Grid ColumnDefinitions="*,300" ColumnSpacing="16">
                <Border Style="{StaticResource Card}" VerticalOptions="Start">
                    <controls:GridLoadingView
                        IsLoading="{Binding IsBusy}"
                        HasError="{Binding HasError}"
                        ErrorMessage="{Binding ErrorMessage}">
                        <controls:GridLoadingView.SkeletonView>
                            <VerticalStackLayout Padding="24" Spacing="16">
                                <controls:SkeletonBlock WidthRequest="420" HeightRequest="16" HorizontalOptions="Start" />
                                <controls:SkeletonBlock WidthRequest="560" HeightRequest="14" HorizontalOptions="Start" />
                                <controls:SkeletonBlock WidthRequest="500" HeightRequest="14" HorizontalOptions="Start" />
                                <controls:SkeletonBlock WidthRequest="380" HeightRequest="14" HorizontalOptions="Start" />
                                <controls:SkeletonBlock Margin="0,8,0,0" WidthRequest="480" HeightRequest="14" HorizontalOptions="Start" />
                                <controls:SkeletonBlock WidthRequest="520" HeightRequest="14" HorizontalOptions="Start" />
                            </VerticalStackLayout>
                        </controls:GridLoadingView.SkeletonView>

                        <VerticalStackLayout
                            Padding="24"
                            Spacing="16"
                            BindableLayout.ItemsSource="{Binding Paragraphs}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Label
                                        FontFamily="Inter"
                                        FontSize="15"
                                        LineHeight="1.45"
                                        Text="{Binding .}"
                                        TextColor="{StaticResource TextPrimary}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </controls:GridLoadingView>
                </Border>

                <VerticalStackLayout Grid.Column="1" Spacing="16">
                    <controls:KpiCard
                        CaptionText="Riesgo alto"
                        IsLoading="{Binding IsBusy}"
                        Level="Alto"
                        Total="{Binding CurrentReport.RiskSummary.Total, FallbackValue=0}"
                        Value="{Binding CurrentReport.RiskSummary.High, FallbackValue=0}" />
                    <controls:KpiCard
                        CaptionText="Riesgo medio"
                        IsLoading="{Binding IsBusy}"
                        Level="Medio"
                        Total="{Binding CurrentReport.RiskSummary.Total, FallbackValue=0}"
                        Value="{Binding CurrentReport.RiskSummary.Medium, FallbackValue=0}" />
                    <controls:KpiCard
                        CaptionText="Riesgo bajo"
                        IsLoading="{Binding IsBusy}"
                        Level="Bajo"
                        Total="{Binding CurrentReport.RiskSummary.Total, FallbackValue=0}"
                        Value="{Binding CurrentReport.RiskSummary.Low, FallbackValue=0}" />
                    <controls:KpiCard
                        CaptionText="Entregas"
                        IsLoading="{Binding IsBusy}"
                        Level="Neutral"
                        Total="{Binding CurrentReport.ExpectedSubmissions, FallbackValue=0}"
                        Value="{Binding CurrentReport.SubmittedCount, FallbackValue=0}" />
                    <controls:KpiCard
                        CaptionText="Clases dictadas"
                        IsLoading="{Binding IsBusy}"
                        Level="Neutral"
                        UnitText="clases"
                        Value="{Binding CurrentReport.ClassCount, FallbackValue=0}" />
                    <controls:KpiCard
                        CaptionText="Intervenciones"
                        IsLoading="{Binding IsBusy}"
                        Level="Neutral"
                        UnitText="contactos"
                        Value="{Binding CurrentReport.InterventionCount, FallbackValue=0}" />
                </VerticalStackLayout>
            </Grid>
        </VerticalStackLayout>
    </controls:PageShell>
</ContentPage>
