<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="UI.Views.SettingsViewPage"
    x:DataType="vm:SettingsViewModel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:UI.Controls"
    xmlns:vm="clr-namespace:UI.ViewModels"
    Shell.NavBarIsVisible="False">

    <controls:PageShell Title="Ajustes" Subtitle="Reglas de cálculo y umbrales de riesgo.">
        <Border
            Padding="24"
            Style="{StaticResource Card}"
            HorizontalOptions="Start"
            MaximumWidthRequest="640"
            WidthRequest="640">
            <VerticalStackLayout Spacing="0">
                <Label Style="{StaticResource CardTitle}" Text="Umbrales de riesgo" />
                <Label
                    Margin="0,4,0,18"
                    Text="Alto si el riesgo es igual o mayor al primer valor; Medio desde el segundo."
                    TextColor="{StaticResource TextSecondary}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Style="{StaticResource FieldLabel}" Text="Alto" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Keyboard="Numeric" Text="{Binding HighThreshold}" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                        <Label Style="{StaticResource FieldLabel}" Text="Medio" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Keyboard="Numeric" Text="{Binding MediumThreshold}" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>
                <HorizontalStackLayout Margin="0,16,0,0" Spacing="12">
                    <Button
                        Command="{Binding SaveThresholdsCommand}"
                        IsEnabled="{Binding CanSave}"
                        Style="{StaticResource PrimaryButton}"
                        Text="Guardar umbrales" />
                    <Label
                        IsVisible="{Binding HasStatusMessage}"
                        Text="{Binding StatusMessage}"
                        TextColor="{StaticResource TextTertiary}"
                        VerticalOptions="Center">
                        <Label.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" TargetType="Label" Value="True">
                                <Setter Property="TextColor" Value="{StaticResource Danger}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </HorizontalStackLayout>

                <BoxView Margin="0,24,0,20" HeightRequest="1" Color="{StaticResource Line}" />
                <Label Style="{StaticResource CardTitle}" Text="Fórmula" />
                <Label
                    Margin="0,4,0,12"
                    Text="Score = asistencia × 60 % + entregas × 40 %. Riesgo = 100 − score."
                    TextColor="{StaticResource TextSecondary}" />
                <HorizontalStackLayout Spacing="8">
                    <controls:StatusPill Kind="neutral" Text="60 % asistencia" />
                    <controls:StatusPill Kind="neutral" Text="40 % entregas" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>
    </controls:PageShell>
</ContentPage>
