<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="UI.Views.AttendancePage"
    x:DataType="vm:AttendanceViewModel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:UI.Controls"
    xmlns:vm="clr-namespace:UI.ViewModels"
    Shell.NavBarIsVisible="False">

    <Grid>
        <controls:PageShell Title="Registrar asistencia" Subtitle="Marcá la asistencia de cada estudiante en la clase elegida.">
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout>
                    <!-- Top bar: Picker and Progress -->
                    <Grid Padding="16,14" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="12">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label Style="{StaticResource FieldLabel}" Text="Clase" VerticalOptions="Center" />
                            <Border Style="{StaticResource FieldBorder}" Padding="8,4">
                                <Picker
                                    ItemsSource="{Binding ClassSessions}"
                                    SelectedItem="{Binding SelectedClassSession}"
                                    WidthRequest="160" />
                            </Border>
                        </HorizontalStackLayout>
                        <controls:Meter
                            Grid.Column="1"
                            BarWidth="140"
                            Fill="{StaticResource Accent}"
                            ShowLabel="False"
                            Value="{Binding RegisteredProgress}"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Column="2"
                            Style="{StaticResource CountLabel}"
                            Text="{Binding RegisteredText}"
                            VerticalOptions="Center" />
                        <Button
                            Grid.Column="4"
                            Command="{Binding MarkAllPresentCommand}"
                            Style="{StaticResource GhostButton}"
                            Text="Marcar todos presentes" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource Line}" />

                    <!-- Sticky Header: Always visible above the rows -->
                    <Grid Padding="20,0" ColumnDefinitions="Auto,*,120" ColumnSpacing="12" HeightRequest="38">
                        <CheckBox
                            IsChecked="{Binding IsAllSelected}"
                            Color="{StaticResource Accent}"
                            VerticalOptions="Center"
                            IsVisible="{Binding CanPerformBulkActions}" />
                        <Label Grid.Column="1" Style="{StaticResource ColumnHeader}" Text="ESTUDIANTE" VerticalOptions="Center" />
                        <Label Grid.Column="2" Style="{StaticResource ColumnHeader}" Text="ESTADO" HorizontalTextAlignment="End" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource Line}" />

                    <!-- Scrollable items area -->
                    <ScrollView MaximumHeightRequest="520">
                        <controls:GridLoadingView
                            IsLoading="{Binding IsBusy}"
                            HasError="{Binding HasError}"
                            ErrorMessage="{Binding ErrorMessage}">
                            <controls:GridLoadingView.SkeletonView>
                                <controls:SkeletonGrid RowCount="5" RowHeight="60">
                                    <controls:SkeletonGrid.RowTemplate>
                                        <DataTemplate>
                                            <Grid
                                                Padding="20,0"
                                                ColumnDefinitions="Auto,*,120"
                                                ColumnSpacing="12"
                                                HeightRequest="60">
                                                <controls:SkeletonBlock WidthRequest="20" HeightRequest="20" Radius="4" VerticalOptions="Center" />
                                                <HorizontalStackLayout Grid.Column="1" Spacing="12" VerticalOptions="Center">
                                                    <controls:SkeletonBlock WidthRequest="32" HeightRequest="32" IsCircle="True" />
                                                    <controls:SkeletonBlock WidthRequest="140" HeightRequest="14" VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                                <controls:SkeletonBlock Grid.Column="2" WidthRequest="90" HeightRequest="26" Radius="999" HorizontalOptions="End" VerticalOptions="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </controls:SkeletonGrid.RowTemplate>
                                </controls:SkeletonGrid>
                            </controls:GridLoadingView.SkeletonView>

                            <VerticalStackLayout>
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:StatusRow">
                                            <VerticalStackLayout>
                                                <controls:HoverRow Padding="20,0" ColumnDefinitions="Auto,*,120" ColumnSpacing="12" HeightRequest="60">
                                                    <CheckBox
                                                        IsChecked="{Binding IsSelected}"
                                                        Color="{StaticResource Accent}"
                                                        VerticalOptions="Center"
                                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CanPerformBulkActions}" />
                                                    <HorizontalStackLayout Grid.Column="1" Spacing="12" VerticalOptions="Center">
                                                        <controls:Avatar FullName="{Binding DisplayName}" />
                                                        <Label
                                                            FontFamily="InterSemibold"
                                                            FontSize="14"
                                                            Text="{Binding DisplayName}"
                                                            VerticalOptions="Center" />
                                                    </HorizontalStackLayout>
                                                    <controls:StatusPill
                                                        Grid.Column="2"
                                                        Text="{Binding StatusDisplay}"
                                                        Kind="{Binding StatusKind}"
                                                        VerticalOptions="Center"
                                                        HorizontalOptions="End" />
                                                </controls:HoverRow>
                                                <BoxView HeightRequest="1" Color="{StaticResource Line}" />
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                                <Label
                                    IsVisible="{Binding HasNoClasses}"
                                    Style="{StaticResource EmptyLabel}"
                                    Text="No hay clases para esta comisión. Agregalas en Calendario." />
                            </VerticalStackLayout>
                        </controls:GridLoadingView>
                    </ScrollView>
                </VerticalStackLayout>
            </Border>
        </controls:PageShell>

        <!-- Floating Action Bar -->
        <controls:FloatingActionBar
            IsActive="{Binding HasSelection}"
            SelectedCount="{Binding SelectedCount}"
            SelectedCountText="{Binding SelectedCountText}"
            ClearSelectionCommand="{Binding ClearSelectionCommand}"
            HorizontalOptions="Center"
            VerticalOptions="End"
            Margin="0,0,0,24">
            <controls:FloatingActionBar.ActionsContent>
                <HorizontalStackLayout Spacing="8">
                    <Button
                        Text="Marcar Presente"
                        Command="{Binding RequestMarkPresentCommand}"
                        Style="{StaticResource PrimaryButton}"
                        HeightRequest="36"
                        Padding="12,0" />
                    <Button
                        Text="Marcar Ausente"
                        Command="{Binding RequestMarkAbsentCommand}"
                        Style="{StaticResource GhostButton}"
                        HeightRequest="36"
                        Padding="12,0" />
                </HorizontalStackLayout>
            </controls:FloatingActionBar.ActionsContent>
        </controls:FloatingActionBar>

        <!-- Confirmation Modal -->
        <controls:ConfirmationModal
            IsOpen="{Binding IsConfirmationOpen}"
            Title="{Binding ConfirmationTitle}"
            Message="{Binding ConfirmationMessage}"
            ConfirmCommand="{Binding ConfirmActionCommand}"
            CancelCommand="{Binding CancelConfirmationCommand}" />
    </Grid>
</ContentPage>
