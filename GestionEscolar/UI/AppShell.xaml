<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="UI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:UI"
    xmlns:views="clr-namespace:UI.Views"
    Title="Gestión Escolar"
    FlyoutBehavior="Locked"
    FlyoutBackgroundColor="{AppThemeBinding Light=White, Dark=#111827}"
    Shell.BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#0F172A}"
    Shell.ForegroundColor="{AppThemeBinding Light=#1A1D23, Dark=#E2E8F0}"
    Shell.TitleColor="{AppThemeBinding Light=#1A1D23, Dark=#F8FAFC}"
    Shell.UnselectedColor="{AppThemeBinding Light=#5E6772, Dark=#CBD5E1}"
    Shell.NavBarHasShadow="False">

    <Shell.Resources>
        <Style TargetType="Label" Class="FlyoutItemLabelStyle">
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#1A1D23, Dark=#E2E8F0}" />
            <Setter Property="FontFamily" Value="OpenSansRegular" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Shell.Resources>

    <!-- Ruta de la nómina -->
    <ShellContent
        Title="Nómina"
        ContentTemplate="{DataTemplate views:StudentListPage}"
        Route="StudentListPage" />

    <!-- Ruta de la grid de seguimiento -->
    <ShellContent
        Title="Seguimiento"
        ContentTemplate="{DataTemplate views:TrackingPage}"
        Route="TrackingPage" />

    <ShellContent
        Title="Entregas"
        ContentTemplate="{DataTemplate views:SubmissionsPage}"
        Route="Submissions" />

    <ShellContent
        Title="Asistencia"
        ContentTemplate="{DataTemplate views:AttendancePage}"
        Route="Attendance" />

    <ShellContent
        Title="Calendario"
        ContentTemplate="{DataTemplate views:CalendarPage}"
        Route="Calendar" />

    <ShellContent
        Title="Ajustes"
        ContentTemplate="{DataTemplate views:SettingsViewPage}"
        Route="SettingsPage" />

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

</Shell>