<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="UI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:UI"
    xmlns:views="clr-namespace:UI.Views"
    Title="Gestión Escolar"
    FlyoutBehavior="Locked"
    FlyoutBackgroundColor="White"
    Shell.BackgroundColor="#F4F6F8"
    Shell.ForegroundColor="#1A1D23"
    Shell.TitleColor="#1A1D23"
    Shell.UnselectedColor="#5E6772"
    Shell.NavBarHasShadow="False">

    <Shell.Resources>
        <Style TargetType="Label" Class="FlyoutItemLabelStyle">
            <Setter Property="TextColor" Value="#1A1D23" />
            <Setter Property="FontFamily" Value="OpenSansRegular" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Shell.Resources>

    <!-- Ruta de la nómina -->
    <ShellContent
        Title="Nómina"
        ContentTemplate="{DataTemplate views:StudentListPage}"
        Route="StudentListPage" />

    <!-- Ruta de la grid de seguimiento -->
    <ShellContent
        Title="Seguimiento"
        ContentTemplate="{DataTemplate views:TrackingPage}"
        Route="TrackingPage" />

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

</Shell>