<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="UI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:UI.Controls"
    xmlns:views="clr-namespace:UI.Views"
    Title=""
    FlyoutBackgroundColor="{StaticResource Side}"
    FlyoutBehavior="Locked"
    FlyoutWidth="232"
    Shell.BackgroundColor="{StaticResource Bg}"
    Shell.ForegroundColor="{StaticResource TextPrimary}"
    Shell.NavBarHasShadow="False"
    Shell.NavBarIsVisible="False">

    <Shell.FlyoutContent>
        <controls:SidebarView />
    </Shell.FlyoutContent>

    <ShellContent
        Title="Nómina"
        ContentTemplate="{DataTemplate views:StudentListPage}"
        Route="StudentListPage" />

    <ShellContent
        Title="Seguimiento"
        ContentTemplate="{DataTemplate views:TrackingPage}"
        Route="TrackingPage" />

    <ShellContent
        Title="Entregas"
        ContentTemplate="{DataTemplate views:SubmissionsPage}"
        Route="Submissions" />

    <ShellContent
        Title="Asistencia"
        ContentTemplate="{DataTemplate views:AttendancePage}"
        Route="Attendance" />

    <ShellContent
        Title="Calendario"
        ContentTemplate="{DataTemplate views:CalendarPage}"
        Route="Calendar" />

    <ShellContent
        Title="Ajustes"
        ContentTemplate="{DataTemplate views:SettingsViewPage}"
        Route="SettingsPage" />

</Shell>
