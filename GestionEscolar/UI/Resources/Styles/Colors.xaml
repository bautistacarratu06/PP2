<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Paleta del mock. Un solo tema: claro y oscuro usan los mismos valores. -->
    <Color x:Key="Bg">#0A0A0A</Color>
    <Color x:Key="Side">#0E0E0E</Color>
    <Color x:Key="Surface">#131313</Color>
    <Color x:Key="Raised">#1B1B1B</Color>
    <Color x:Key="Line">#232323</Color>
    <Color x:Key="LineStrong">#303030</Color>
    <Color x:Key="TextPrimary">#EDEDED</Color>
    <Color x:Key="TextSecondary">#8E8E93</Color>
    <Color x:Key="TextTertiary">#5C5C61</Color>
    <Color x:Key="Accent">#9D8CFF</Color>
    <Color x:Key="AccentStrong">#7C6AF2</Color>
    <Color x:Key="AccentSoft">#249D8CFF</Color>
    <Color x:Key="Danger">#F87171</Color>
    <Color x:Key="DangerSoft">#1FF87171</Color>
    <Color x:Key="Warning">#FBBF24</Color>
    <Color x:Key="WarningSoft">#1FFBBF24</Color>
    <Color x:Key="Success">#34D399</Color>
    <Color x:Key="SuccessSoft">#1F34D399</Color>

    <LinearGradientBrush x:Key="LogoBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#9D8CFF" Offset="0" />
        <GradientStop Color="#6D58E8" Offset="1" />
    </LinearGradientBrush>

    <!-- Claves que ya usaban los estilos de plantilla, redirigidas a la paleta nueva. -->
    <Color x:Key="Primary">#7C6AF2</Color>
    <Color x:Key="PrimaryDark">#9D8CFF</Color>
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>
    <Color x:Key="Secondary">#8E8E93</Color>
    <Color x:Key="SecondaryDarkText">#EDEDED</Color>
    <Color x:Key="Tertiary">#5C5C61</Color>
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#0A0A0A</Color>
    <Color x:Key="Magenta">#9D8CFF</Color>
    <Color x:Key="OffBlack">#0A0A0A</Color>
    <Color x:Key="Gray100">#EDEDED</Color>
    <Color x:Key="Gray200">#8E8E93</Color>
    <Color x:Key="Gray300">#5C5C61</Color>
    <Color x:Key="Gray400">#303030</Color>
    <Color x:Key="Gray500">#232323</Color>
    <Color x:Key="Gray600">#1B1B1B</Color>
    <Color x:Key="Gray900">#131313</Color>
    <Color x:Key="Gray950">#0A0A0A</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
